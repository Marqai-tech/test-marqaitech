generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ SaaS MULTI-TENANT CORE ============

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?

  // Tenant type classification
  tenantType  String   @default("single_company") // single_company, multi_company_group, staffing_company, enterprise_group, white_label_partner

  // Company details
  companyName String?
  legalName   String?
  industry    String?

  // Location
  country     String?
  currency    String   @default("USD")

  // Admin info
  adminName   String?
  adminEmail  String?
  adminMobile String?

  // Subscription
  plan        String   @default("starter") // starter, professional, enterprise, global_enterprise, staffing_suite, white_label
  employeeLimit Int    @default(50)
  userLimit     Int    @default(10)
  storageLimit  Int    @default(5) // GB
  aiCreditLimit Int    @default(100)
  trialStartDate  DateTime?
  trialEndDate    DateTime?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  billingCycle  String  @default("monthly") // monthly, annual
  paymentStatus String  @default("pending") // pending, paid, overdue, cancelled

  // Status
  status      String   @default("active") // active, suspended, trial, expired
  logo        String?
  timezone    String   @default("UTC")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyGroups CompanyGroup[]
  users         User[]
  notifications Notification[]
}

model CompanyGroup {
  id       String @id @default(cuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Company {
  id             String @id @default(cuid())
  name           String
  code           String?
  legalName      String?
  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)
  parentCompanyId String?

  registrationNo String?
  taxId          String?
  panTanCin      String?
  gstVatNumber   String?
  country        String?
  currency       String @default("USD")
  payrollCurrency String @default("USD")
  reportingCurrency String @default("USD")
  timezone       String @default("UTC")
  financialYear  String @default("April-March")
  payrollFrequency String @default("monthly") // monthly, bi-monthly, weekly, bi-weekly

  address        String?
  city           String?
  state          String?
  zipCode        String?
  phone          String?
  email          String?
  website        String?
  logo           String?
  bankDetails    String? // JSON string for bank details

  companyAdmin   String?
  status         String @default("active")

  branches      Branch[]
  departments   Department[]
  designations  Designation[]
  grades        Grade[]
  costCenters   CostCenter[]
  businessUnits BusinessUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyGroupId])
}

model Branch {
  id        String @id @default(cuid())
  name      String
  code      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  country          String?
  state            String?
  city             String?
  address          String?
  zipCode          String?
  phone            String?
  email            String?
  latitude         String?
  longitude        String?
  timezone         String @default("UTC")
  branchManager    String?
  holidayCalendar  String? // JSON reference
  attendancePolicy String?
  status           String @default("active")

  departments Department[]
  employees   Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Department {
  id        String @id @default(cuid())
  name      String
  code      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  headId   String?
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  costCenterId  String?
  businessUnitId String?
  status String @default("active")

  designations Designation[]
  employees    Employee[]
  jobPostings  JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
}

model Designation {
  id           String @id @default(cuid())
  title        String
  code         String?
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  level        Int    @default(1)
  gradeId      String?
  minSalary    Float?
  maxSalary    Float?
  status       String @default("active")

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([departmentId])
}

// ============ USER & AUTH ============

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  avatar   String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role       String @default("employee") // super_admin, tenant_admin, hr_admin, manager, employee
  status     String @default("active")
  lastLogin  DateTime?
  lastLogout DateTime?

  employee Employee?

  notifications      Notification[]
  auditLogs          AuditLog[]
  loginActivities    LoginActivity[]
  userRoles          UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
}

// ============ EMPLOYEE CORE ============

model Employee {
  id             String @id @default(cuid())
  employeeId     String @unique
  firstName      String
  lastName       String
  email          String
  phone          String?
  avatar         String?

  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  designationId  String
  designation    Designation @relation(fields: [designationId], references: [id])
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId      String?

  dateOfJoining  DateTime
  dateOfBirth    DateTime?
  gender         String?
  maritalStatus  String?
  nationality    String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  bloodGroup     String?
  emergencyContactName  String?
  emergencyContactPhone String?

  status         String @default("active") // active, on_leave, terminated, resigned

  bankName       String?
  bankAccountNo  String?
  bankIfscCode   String?
  panNumber      String?
  aadhaarNumber  String?
  taxId          String?

  salary         Float?
  salaryCurrency String @default("USD")

  // Relations
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  attendance        Attendance[]
  payrolls          Payroll[]
  documents         Document[]
  dependents        Dependent[]
  qualifications    Qualification[]
  experiences       Experience[]
  skills            EmployeeSkill[]
  performanceReviews PerformanceReview[]
  goals             Goal[]
  trainings         TrainingEnrollment[]
  assetAssignments  AssetAssignment[]
  incidentReports   IncidentReport[]
  travelRequests    TravelRequest[]
  expenseClaims     ExpenseClaim[]
  timesheets        Timesheet[]
  feedbacks         Feedback[]  @relation("FeedbackTo")
  givenFeedbacks    Feedback[]  @relation("FeedbackFrom")
  promotions        Promotion[]
  grievances        Grievance[]
  separations       Separation[]
  onboardingTasks   OnboardingTask[]
  reimbursements    Reimbursement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
}

model Dependent {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name       String
  relation   String
  dateOfBirth DateTime?
  gender     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Qualification {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  degree      String
  institution String
  year        Int
  percentage  Float?
  certificate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Experience {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  company     String
  designation String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model EmployeeSkill {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  skill      String
  level      String @default("intermediate") // beginner, intermediate, advanced, expert
  yearsOfExp Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ RECRUITMENT ============

model ManpowerRequisition {
  id              String @id @default(cuid())
  requisitionId   String @unique // auto-generated: REQ-YYYY-NNNN
  companyId       String?
  branchId        String?
  departmentId    String?
  designationId   String?
  hiringManagerId String?

  positionType    String @default("new") // new, replacement
  replacementEmployeeId String?
  numberOfOpenings Int @default(1)
  employmentType  String @default("full-time") // full-time, part-time, contract, internship, temporary
  skillsRequired  String?
  experienceRequired String?
  qualification   String?
  salaryBudget    String?
  projectId       String?
  clientId        String?
  priority        String @default("medium") // low, medium, high, critical
  expectedJoiningDate DateTime?
  justification   String?

  approvalStatus  String @default("draft") // draft, pending_manager, pending_hr, pending_budget, approved, rejected, cancelled
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  requestedBy     String?
  status          String @default("active") // active, fulfilled, cancelled

  jobPostingId    String? // linked job posting after approval

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([approvalStatus])
  @@index([status])
}

model JobPosting {
  id              String @id @default(cuid())
  title           String
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])

  position        String
  location        String?
  type            String @default("full-time") // full-time, part-time, contract, internship
  experience      String?
  salary          String?
  description     String
  requirements    String?
  status          String @default("draft") // draft, pending_approval, open, closed, on_hold, filled
  approvalStatus  String @default("pending") // pending, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  postedDate      DateTime?
  closingDate     DateTime?
  vacancies       Int @default(1)

  // Source tracking
  isInternal      Boolean @default(false)
  isExternal      Boolean @default(true)
  externalPortals String? // JSON: ["linkedin","indeed","naukri"]
  vendorId        String?
  subVendorId     String?

  // Requisition link
  requisitionId   String?

  applications    JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

model JobApplication {
  id              String @id @default(cuid())
  jobPostingId    String
  jobPosting      JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  // Candidate info (enhanced)
  candidateId     String? // link to Candidate model if exists
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  resume          String?
  coverLetter     String?
  source          String @default("website") // website, referral, linkedin, indeed, naukri, vendor, internal, other
  vendorId        String?
  subVendorId     String?

  // Candidate details
  skills          String? // JSON array of skills
  experience      String?
  currentCtc      String?
  expectedCtc     String?
  noticePeriod    String?
  currentLocation String?

  // AI fields
  aiResumeScore   Float?
  aiInterviewScore Float?
  aiScreeningResult String? // JSON with detailed AI analysis

  // Status tracking
  status          String @default("applied") // applied, screening, ai_screening, ai_interview, shortlisted, interview, offered, hired, rejected, on_hold, withdrawn
  appliedDate     DateTime @default(now())
  rating          Int?
  notes           String?
  interviewDate   DateTime?
  expectedSalary  String?

  // Workflow stage tracking
  recruiterStatus String @default("new") // new, screening, shortlisted, interview_scheduled, offered, rejected, on_hold
  clientStatus    String? // pending, shortlisted, interview_scheduled, selected, rejected
  offerStatus     String? // draft, pending_approval, approved, released, accepted, rejected, withdrawn

  interviews      Interview[]
  offers          Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobPostingId])
  @@index([status])
  @@index([candidateId])
}

model Interview {
  id              String @id @default(cuid())
  jobApplicationId String
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  round           Int @default(1)
  type            String @default("technical") // ai_screening, technical, hr, managerial, client, final
  title           String? // e.g. "Technical Round 1", "AI Pre-screening"
  date            DateTime
  time            String?
  duration        Int? // in minutes
  location        String?
  meetingUrl      String?

  // Interviewer info
  interviewerIds  String? // JSON array of employee IDs
  interviewerNames String? // JSON array of names for display

  status          String @default("scheduled") // scheduled, in_progress, completed, cancelled, rescheduled, no_show
  feedback        String?
  score           Int?
  recommendation  String? // strong_yes, yes, no, strong_no
  aiScore         Int?
  aiFeedback      String?
  aiInterviewUrl  String? // link to AI interview recording

  rescheduledFrom DateTime?
  rescheduledReason String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobApplicationId])
  @@index([status])
  @@index([date])
}

model Offer {
  id              String @id @default(cuid())
  jobApplicationId String
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  offerNumber     String @unique // auto-generated: OFR-YYYY-NNNN
  candidateName   String
  candidateEmail  String
  jobTitle        String?
  departmentId    String?

  // Compensation
  offeredSalary   Float?
  currency        String @default("USD")
  salaryBreakup   String? // JSON: { basic, hra, da, allowances, deductions }
  joiningBonus    Float?
  retentionBonus  Float?
  variablePay     Float?

  // Dates
  offerDate       DateTime @default(now())
  joiningDate     DateTime?
  offerExpiryDate DateTime?

  // Approval workflow
  approvalStatus  String @default("draft") // draft, pending_hr, pending_finance, pending_management, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  // Candidate response
  candidateResponse String? // accepted, rejected, negotiation, pending
  responseDate    DateTime?
  negotiationNotes String?

  status          String @default("draft") // draft, pending_approval, approved, released, accepted, rejected, withdrawn, expired

  // Conversion
  convertedToEmployee Boolean @default(false)
  employeeId      String?

  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobApplicationId])
  @@index([status])
  @@index([approvalStatus])
}

// ============ ONBOARDING ============

model OnboardingTask {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  task       String
  category   String @default("general") // general, it_setup, hr_docs, training, introduction
  status     String @default("pending") // pending, in_progress, completed
  dueDate    DateTime?
  completedDate DateTime?
  assignedBy String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ LEAVE MANAGEMENT ============

model LeaveType {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  description String?
  defaultDays Int @default(0)
  isPaid      Boolean @default(true)
  carryForward Boolean @default(false)
  maxCarryForward Int @default(0)
  status      String @default("active")

  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveBalance {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  year        Int
  total       Float @default(0)
  used        Float @default(0)
  remaining   Float @default(0)
  carryForward Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

model LeaveRequest {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String @default("pending") // pending, approved, rejected, cancelled
  approvedBy  String?
  approvedAt  DateTime?
  comments    String?
  halfDay     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ ATTENDANCE ============

model Attendance {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String @default("present") // present, absent, late, half_day, holiday, weekend, on_leave
  workHours  Float?
  overtime   Float?
  notes      String?
  location   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// ============ PAYROLL ============

model Payroll {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month       Int
  year        Int
  basicSalary Float @default(0)
  hra         Float @default(0)
  da          Float @default(0)
  conveyance  Float @default(0)
  medical     Float @default(0)
  otherAllowances Float @default(0)
  grossSalary Float @default(0)
  pf          Float @default(0)
  esi         Float @default(0)
  tax         Float @default(0)
  professionalTax Float @default(0)
  otherDeductions Float @default(0)
  totalDeductions Float @default(0)
  netSalary   Float @default(0)
  currency    String @default("USD")
  status      String @default("draft") // draft, processed, paid, cancelled
  paidDate    DateTime?
  paySlip     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([status])
}

// ============ PERFORMANCE ============

model PerformanceReview {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewCycle String
  reviewPeriod String?
  reviewerId  String?
  rating      Float @default(0)
  goalsRating Float @default(0)
  skillsRating Float @default(0)
  behaviorRating Float @default(0)
  overallRating Float @default(0)
  comments    String?
  strengths   String?
  improvements String?
  status      String @default("pending") // pending, in_progress, completed
  reviewDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Goal {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String @default("performance") // performance, development, behavioral
  priority    String @default("medium") // low, medium, high
  status      String @default("not_started") // not_started, in_progress, completed, cancelled
  progress    Int @default(0)
  startDate   DateTime
  endDate     DateTime
  completedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ TRAINING ============

model Training {
  id          String @id @default(cuid())
  title       String
  description String?
  category    String?
  trainer     String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  mode        String @default("online") // online, offline, hybrid
  status      String @default("upcoming") // upcoming, ongoing, completed, cancelled
  maxParticipants Int?
  cost        Float?

  enrollments TrainingEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingEnrollment {
  id         String @id @default(cuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status     String @default("enrolled") // enrolled, completed, dropped, failed
  score      Float?
  feedback   String?
  completedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainingId, employeeId])
  @@index([employeeId])
}

// ============ ASSETS ============

model Asset {
  id           String @id @default(cuid())
  name         String
  assetTag     String @unique
  category     String // laptop, desktop, phone, tablet, monitor, other
  brand        String?
  model        String?
  serialNumber String?
  purchaseDate DateTime?
  purchaseCost Float?
  status       String @default("available") // available, assigned, maintenance, retired
  condition    String @default("new") // new, good, fair, poor

  assignments AssetAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetAssignment {
  id         String @id @default(cuid())
  assetId    String
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  assignedDate  DateTime @default(now())
  returnDate    DateTime?
  expectedReturn DateTime?
  condition     String @default("good")
  notes         String?
  status        String @default("assigned") // assigned, returned, lost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([assetId])
}

// ============ DOCUMENTS ============

model Document {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name       String
  type       String // offer_letter, id_proof, contract, certificate, policy, other
  fileUrl    String?
  status     String @default("active")
  uploadedAt DateTime @default(now())
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ INCIDENTS ============

model IncidentReport {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String // safety, security, harassment, discrimination, other
  title       String
  description String
  severity    String @default("medium") // low, medium, high, critical
  status      String @default("open") // open, investigating, resolved, closed
  reportedDate DateTime @default(now())
  resolution  String?
  resolvedDate DateTime?
  reportedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ TRAVEL ============

model TravelRequest {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  purpose     String
  destination String
  startDate   DateTime
  endDate     DateTime
  mode        String @default("flight") // flight, train, car, bus
  estimatedCost Float?
  approvedBy  String?
  status      String @default("pending") // pending, approved, rejected, cancelled, completed
  approvedAt  DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ EXPENSES ============

model ExpenseClaim {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  category    String // travel, food, accommodation, transport, medical, other
  amount      Float
  currency    String @default("USD")
  date        DateTime
  description String?
  receipt     String?
  status      String @default("pending") // pending, approved, rejected, paid
  approvedBy  String?
  approvedAt  DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ TIMESHEET ============

model Timesheet {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  project     String?
  task        String?
  hours       Float @default(0)
  description String?
  status      String @default("draft") // draft, submitted, approved, rejected
  approvedBy  String?
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
}

// ============ FEEDBACK ============

model Feedback {
  id         String @id @default(cuid())
  fromId     String
  from       Employee @relation("FeedbackFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         Employee @relation("FeedbackTo", fields: [toId], references: [id], onDelete: Cascade)

  type       String @default("peer") // peer, manager, self, 360
  rating     Int?
  comments   String
  isAnonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromId])
  @@index([toId])
}

// ============ PROMOTION ============

model Promotion {
  id              String @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  fromDesignation String
  toDesignation   String
  fromDepartment  String
  toDepartment    String?
  effectiveDate   DateTime
  salaryChange    Float?
  reason          String?
  status          String @default("pending") // pending, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ GRIEVANCE ============

model Grievance {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String // harassment, discrimination, workload, salary, other
  subject     String
  description String
  priority    String @default("medium") // low, medium, high, critical
  status      String @default("open") // open, in_progress, resolved, closed
  assignedTo  String?
  resolution  String?
  resolvedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ SEPARATION ============

model Separation {
  id              String @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type            String // resignation, termination, retirement, layoff
  reason          String
  noticePeriod    Int @default(30)
  lastWorkingDate DateTime
  status          String @default("pending") // pending, notice_period, completed, cancelled
  exitInterview   String?
  settlementAmount Float?
  approvedBy      String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ============ NOTIFICATIONS ============

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  type     String @default("info") // info, success, warning, error, login, logout, workflow
  category String @default("system") // system, auth, leave, payroll, recruitment, performance, workflow, alert
  link     String?
  isRead   Boolean @default(false)
  isEmailSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([tenantId])
}

