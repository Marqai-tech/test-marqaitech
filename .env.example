# ============================================
# 3 Boxes HRMS - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# On Vercel, set these in Project Settings → Environment Variables
# On Hostinger VPS, set these in /home/3boxeshrms/.env

# ----- DATABASE (Required) -----
# Neon/PostgreSQL connection string
# Priority: POSTGRES_PRISMA_URL > POSTGRES_URL > DATABASE_URL
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=10"
POSTGRES_URL="postgresql://user:password@host/database?sslmode=require"

# ----- AUTH (Required) -----
# JWT secret for token signing (use a strong random string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-change-this-in-production"

# ----- APP (Required) -----
# Base URL of the application (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ----- MULTI-TENANT (Required for production) -----
# Root domain for subdomain-based tenant resolution
# e.g., "3boxeshrms.com" means marqaitechgroup.3boxeshrms.com resolves to tenant "marqaitechgroup"
NEXT_PUBLIC_ROOT_DOMAIN="3boxeshrms.com"

# ----- NOTES -----
# - The app name is hardcoded as "3 Boxes HRMS" in the source code
# - Subdomain routing: <tenant-slug>.3boxeshrms.com resolves to the tenant
# - Super admins can log in from any subdomain
# - Other users must log in from their own tenant's subdomain
# - If NEXT_PUBLIC_ROOT_DOMAIN is not set, falls back to generic subdomain extraction
