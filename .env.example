# ============================================
# 3 Boxes HRMS - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# On Vercel, set these in Project Settings → Environment Variables

# ----- DATABASE (Required) -----
# Neon/PostgreSQL connection string
# Priority: POSTGRES_PRISMA_URL > POSTGRES_URL > DATABASE_URL
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=10"
POSTGRES_URL="postgresql://user:password@host/database?sslmode=require"

# ----- AUTH (Required) -----
# JWT secret for token signing (use a strong random string in production)
JWT_SECRET="your-jwt-secret-change-this-in-production"

# ----- APP (Optional) -----
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ----- NOTES -----
# - The app name is hardcoded as "3 Boxes HRMS" in the source code
# - The tenant name in the database is auto-fixed to "3 Boxes Corp" on every request
# - If you see "eh2r" or any wrong branding, visit /api/fix-tenant to fix the database
