# ============================================
# 3 Boxes HRMS - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# On Vercel, set these in Project Settings → Environment Variables
# On Hostinger VPS, set these in /home/3boxeshrms/.env

# ----- DATABASE (Required) -----
# Neon/PostgreSQL connection string
# Priority: POSTGRES_PRISMA_URL > POSTGRES_URL > DATABASE_URL
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Optional, for the local biometric test seed only; must point to localhost.
LOCAL_TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
POSTGRES_PRISMA_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=10"
POSTGRES_URL="postgresql://user:password@host/database?sslmode=require"

# ----- AUTH (Required) -----
# JWT secret for token signing (use a strong random string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-change-this-in-production"

# ----- APP (Required) -----
# Base URL of the application (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ----- MULTI-TENANT (Required for production) -----
# Root domain for subdomain-based tenant resolution
# e.g., "3boxeshrms.com" means marqaitechgroup.3boxeshrms.com resolves to tenant "marqaitechgroup"
NEXT_PUBLIC_ROOT_DOMAIN="3boxeshrms.com"

# ----- SITE MODE (PERMANENT FIX - Required on Vercel) -----
# Determines which tenants are hidden. Takes ABSOLUTE precedence over host-header detection.
# 'live' = production site (3boxeshrms.com) — hides '3boxeshrms' and '3boxes-hrms-demo' tenants
# 'demo' = showcase site (nexus-hrms-mu.vercel.app) — hides 'marqaitechgroup' tenant
# MUST be set in Vercel Project Settings → Environment Variables for both deployments
SITE_MODE="live"
NEXT_PUBLIC_SITE_MODE="live"

# ----- TEAM OFFICE BIOMETRIC API -----
# Keep the password in .env.local or Vercel Secret variables; never commit it.
ETIMEOFFICE_BASE_URL="https://api.etimeoffice.com/api"
ETIMEOFFICE_CORPORATE_ID=""
ETIMEOFFICE_USERNAME=""
ETIMEOFFICE_PASSWORD=""
# Use ALL for normal tenant sync. For a local test, set the device code (e.g. 010)
# so the test database only receives that employee's punches.
ETIMEOFFICE_EMP_CODE="ALL"
# Optional device-to-HRMS overrides. Example: device 007 is HRMS MARQ008.
ETIMEOFFICE_EMPLOYEE_MAP="007:MARQ008,015:MARQ015"
# Seed from the latest successful API MaxRecord supplied during setup; the
# database checkpoint advances automatically after the first successful sync.
# Escape $ in Next.js .env files so it stays part of the cursor.
# In the Vercel dashboard, enter the literal value 102026$383 (no backslash).
ETIMEOFFICE_LAST_RECORD="102026\$383"
ETIMEOFFICE_TENANT_SLUG="marqaitechgroup"
ETIMEOFFICE_DEVICE_SERIAL="A230501663"
ETIMEOFFICE_DEVICE_NAME="BIO-PARK D01 (Team Office)"
ETIMEOFFICE_TIMEZONE="Asia/Kolkata"
# Required by the scheduled Vercel sync. Add a random secret to Vercel; do not commit it.
CRON_SECRET=""

# ----- NOTES -----
# - The app name is hardcoded as "3 Boxes HRMS" in the source code
# - Subdomain routing: <tenant-slug>.3boxeshrms.com resolves to the tenant
# - Super admins can log in from any subdomain
# - Other users must log in from their own tenant's subdomain
# - If NEXT_PUBLIC_ROOT_DOMAIN is not set, falls back to generic subdomain extraction
