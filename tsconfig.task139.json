{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/app/(dashboard)/my-profile/page.tsx",
    "src/app/(dashboard)/employees/update-requests/page.tsx",
    "src/app/(dashboard)/helpdesk/page.tsx",
    "src/app/(dashboard)/dashboard/page.tsx",
    "src/app/(dashboard)/social-feed/page.tsx",
    "src/app/(dashboard)/employees/management/page.tsx",
    "src/app/(dashboard)/employees/page.tsx",
    "src/app/(dashboard)/employees/[id]/page.tsx",
    "src/components/employees/SocialFeedsSection.tsx",
    "src/app/api/users/profile/route.ts",
    "src/app/api/auth/me/route.ts",
    "src/app/api/employees/avatar-approvals/route.ts",
    "src/app/api/employees/org-stats/route.ts",
    "src/app/api/employees/update-requests/route.ts",
    "src/app/api/employees/update-requests/[id]/route.ts",
    "src/app/api/employees/route.ts",
    "src/lib/employee-update-request.ts",
    "src/lib/notification-events.ts",
    "src/lib/document-viewer.ts",
    "src/lib/feed-permissions.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}