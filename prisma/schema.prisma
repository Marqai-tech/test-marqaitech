// ============ P0 FIX: MISSING MODELS (added 2026-06-20) ============
//
// These models were referenced by API routes but never declared in the schema,
// causing runtime crashes (prisma.<model> is not a function). Adding them
// unblocks: preboarding, exit-workflow, okrs, exit-interview, engagement,
// and ai-admin routes.
//
// All are appended at the end of the schema and use only ADDITIVE DDL in
// schema-sync.{js,ts} so they don't affect existing models.

// ─── Preboarding Candidate (REQ-ONB-02 pre-onboarding pipeline) ───
// Used by /api/preboarding/** — tracks candidates between offer acceptance
// and Day-1 joining (document collection, BGV, IT provisioning, etc.).
model PreboardingCandidate {
  id              String   @id @default(cuid())
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  jobTitle        String?
  departmentId    String?
  offeredSalary   Float?
  currency        String   @default("INR")
  offerDate       DateTime @default(now())
  joiningDate     DateTime?
  notes           String?

  // Offer link (raw string — not a FK to Offer, to keep the model self-contained)
  offerId         String?

  // Status state machine:
  // offer_accepted → document_collection → bgv → provisioning → asset_request → joined → cancelled
  status          String   @default("offer_accepted")

  // Document collection (JSON map of docType → fileUrl)
  documentsUploaded String?

  // Background verification
  backgroundCheckStatus  String  @default("pending") // pending, in_progress, cleared, failed
  backgroundCheckNotes   String?

  // HR + IT gate flags
  hrVerified         Boolean @default(false)
  accountProvisioned Boolean @default(false)

  // ─── REQ-ONB-01/05/08: Cascade wiring ───
  // Populated when preboarding completes — points to the newly created Employee record.
  employeeId         String?
  // Requisition that this hire fulfills (optional — for analytics).
  requisitionId      String?
  // IT provisioning tracking
  itProvisioningStatus String @default("pending") // pending | initiated | completed | failed
  itProvisioningNotes  String?
  // Buddy assigned for Day-1 (Employee.id)
  buddyEmployeeId    String?
  // Welcome series tracking
  welcomeSeriesInitiated Boolean @default(false)

  // Background checks (REQ-ONB-03)
  backgroundChecks   BackgroundCheck[]
  // Welcome series emails (REQ-ONB-04)
  welcomeSeriesEmails WelcomeSeriesEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([candidateEmail])
  @@index([employeeId])
}

// ─── Exit Request (REQ-EXIT-01 employee self-service resignation) ───
// Used by /api/exit-workflow/** — alternative to /api/separation for the
// employee-initiated resignation flow. Kept separate from Separation so
// existing admin-facing separation logic is undisturbed.
model ExitRequest {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type            String   @default("resignation") // resignation, termination, retirement, layoff
  reason          String?
  noticePeriodEndDate DateTime?
  lastWorkingDate DateTime?

  // pending → in_progress → completed | cancelled | withdrawn
  status          String   @default("pending")

  // Snapshot of clearance state (free-text until clearance-task model is added)
  clearanceNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
}

// ─── OKR + KeyResult (REQ-PER-01 cascade) ───
// Used by /api/okrs/** — supports Company → Sub-Company → Project → Individual
// cascade via parentOkrId self-reference and category field.
model OKR {
  id          String   @id @default(cuid())
  objective   String

  // Owner: an Employee (individual OKR) — for company/group/project OKRs,
  // ownerId can store the company/project ID and category will distinguish.
  // Made nullable for company-level OKRs (REQ-PER-01 cascade).
  ownerId     String?
  owner       Employee?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Cascade ownership — for category='company' or 'sub_company', companyId is set.
  // For category='project', projectId is set. For category='individual', ownerId is set.
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Audit: who created this OKR
  createdById String?

  quarter     String   @default("Q1 2026")
  year        Int      @default(2026)

  // Cascade level: 'company' | 'sub_company' | 'project' | 'individual'
  category    String   @default("individual")

  // Self-reference for parent-child cascade
  parentOkrId String?
  parentOkr   OKR?     @relation("OkrCascade", fields: [parentOkrId], references: [id], onDelete: SetNull)
  childOkrs   OKR[]    @relation("OkrCascade")

  // Status: draft | active | at_risk | completed | missed
  status      String   @default("draft")

  keyResults  KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([projectId])
  @@index([parentOkrId])
  @@index([category])
  @@index([quarter])
  @@index([year])
}

model KeyResult {
  id           String  @id @default(cuid())
  okrId        String
  okr          OKR     @relation(fields: [okrId], references: [id], onDelete: Cascade)

  title        String
  targetValue  Float   @default(100)
  currentValue Float   @default(0)
  unit         String? // '%', 'count', 'USD', etc.

  // Status: not_started | in_progress | completed | missed
  status       String  @default("not_started")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([okrId])
}

// ─── Exit Interview (REQ-EXIT-05 digital exit interview forms) ───
// Used by /api/exit-interview/** — structured interview record linked to
// Separation + Employee. The existing Separation.exitInterview free-text
// field is kept for backwards compatibility.
model ExitInterview {
  id             String   @id @default(cuid())
  separationId   String
  separation     Separation @relation(fields: [separationId], references: [id], onDelete: Cascade)

  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  interviewDate  DateTime @default(now())
  interviewer    String?
  reason         String?
  feedback       String?
  rating         Int?     // 1-5
  wouldRehire    Boolean?
  suggestions    String?

  // Multi-lingual: language code (e.g. 'en', 'es', 'fr') — defaults to tenant language
  language       String   @default("en")

  // AI sentiment analysis (REQ-EXIT-06) — populated by /api/exit-interview POST
  sentimentScore Float?
  sentimentLabel String?  // positive | neutral | negative
  sentimentSummary String?

  status         String   @default("completed") // draft, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([separationId])
  @@index([employeeId])
}

// ─── Engagement: Survey + SurveyResponse + Recognition ───
// Used by /api/engagement/** — replaces the missing engagement models.
model Survey {
  id              String   @id @default(cuid())
  title           String
  description     String?
  type            String   @default("pulse") // pulse, annual, onboarding, exit
  status          String   @default("draft") // draft, active, closed
  anonymous       Boolean  @default(true)
  targetAudience  String   @default("all") // all, department, company, role
  questions       String   // JSON array of question objects
  startDate       DateTime @default(now())
  endDate         DateTime?

  responses       SurveyResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  answers     String   // JSON array of {questionId, value}
  sentiment   String?  // positive | neutral | negative (AI-computed)

  createdAt DateTime @default(now())

  @@index([surveyId])
  @@index([employeeId])
}

model Recognition {
  id          String   @id @default(cuid())
  // fromId is a User.id (the recognizer), toId is an Employee.id (the recipient)
  fromId      String
  toId        String
  toEmployee  Employee @relation(fields: [toId], references: [id], onDelete: Cascade)

  type        String   @default("kudos") // kudos, shoutout, award, milestone
  title       String   @default("")
  message     String
  points      Int      @default(0)
  isPublic    Boolean  @default(true)
  category    String   @default("general") // general, performance, culture, leadership

  createdAt DateTime @default(now())

  @@index([toId])
  @@index([category])
}

// ─── AI Admin Console: AIConfig + AIPromptLog ───
// Used by /api/ai-admin/** — configures prompts/models and logs every AI call
// for observability, bias auditing, and cost tracking.
model AIConfig {
  id          String   @id @default(cuid())
  name        String
  type        String   // prompt_template, model_config, system_prompt
  category    String   // recruitment, performance, training, interview, chatbot
  content     String   // the prompt body / config JSON
  model       String   @default("gpt-4") // gpt-4, glm-4, claude-3, etc.
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2048)
  isActive    Boolean  @default(true)
  version     String   @default("1.0")
  description String?

  // Bias / safety guardrails (JSON)
  biasChecks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isActive])
}

model AIPromptLog {
  id           String   @id @default(cuid())
  category     String   // recruitment, performance, training, interview, chatbot
  status       String   @default("success") // success, error, timeout
  model        String?
  promptInput  String?  // truncated prompt for audit
  promptOutput String?  // truncated output for audit
  latencyMs    Int      @default(0)
  tokensUsed   Int      @default(0)
  errorMessage String?

  // Bias audit fields
  biasFlag     Boolean  @default(false)
  biasReason   String?

  userId       String?
  configId     String?

  createdAt DateTime @default(now())

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// ============ DOCUMENTATION HUB ============

model DocCategory {
