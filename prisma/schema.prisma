// ============ SRS GAP CLOSURE — ADDENDUM 2 ============
// Models added to close gaps surfaced by the consolidated SRS audit:
//   REQ-CLT-09  — Client feedback into Performance (360°)
//   REQ-ENG-04  — Intelligent approval router (manager on leave → backup)
//   REQ-ENG-08  — Scheduled report distribution
//   REQ-VEN-06  — Contractor limited onboarding (Collab/PM access, no HRIS/Payroll)
//   REQ-AI-MKT-01 — Hyper-personalized catalog signals cache
//   REQ-ENG-07  — Cross-module anomaly insights cache
//   REQ-ENG-03  — Workflow trigger registry (data events / cron / webhooks)
//   REQ-PM-05   — Utilization daily snapshot

model ClientFeedback {
