  gatePassHalfDayOnExceed   Boolean @default(true)
  gatePassHalfDayNextDay    Boolean @default(true)
  gatePassEarlyHours        Int @default(1)

  priority        Int @default(0) // higher = more specific, takes precedence
  status          String @default("active") // active | inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employmentType])
  @@index([branchId])
}

