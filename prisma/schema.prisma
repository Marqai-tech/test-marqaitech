  enablePreScreening      Boolean  @default(true)
  enableProctoring        Boolean  @default(true)
  enableDynamicFollowUp   Boolean  @default(true)
  status                  String   @default("draft") // draft, active, archived
  preScreenFilters        Json?
  evaluationConfig        Json?
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  questions               InterviewSetQuestion[]
  sessions                InterviewSession[]
  invitations             InterviewInvitation[]

  @@index([tenantId])
  @@index([status])
}

model InterviewSetQuestion {
  id              String   @id @default(cuid())
  setId           String
  order           Int
  category        String   // technical, behavioral, situational, cv_based, cognitive
  question        String
  expectedPoints   String?
  followUpPrompts  String?
  duration        Int?
  isMandatory     Boolean  @default(true)
  difficulty      String   @default("medium") // easy, medium, hard
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  set             InterviewSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

model InterviewSession {
  id                  String    @id @default(cuid())
  setId               String
  candidateName       String
  candidateEmail      String
  candidatePhone      String?
  resumeUrl           String?
  resumeParsed        Json?
  language            String    @default("en")
  status              String    @default("invited") // invited, pre_screen, in_progress, completed, expired, disqualified
  preScreenResult     Json?
  startedAt           DateTime?
  completedAt         DateTime?
  videoUrl            String?
  audioUrl            String?
  transcriptUrl       String?
  fullTranscript      String?
  overallScore        Int?
  communicationScore  Int?
  grammarScore        Int?
  fluencyScore        Int?
  comprehensionScore  Int?
  vocabularyScore     Int?
  cognitiveScore      Int?
  skillMatchScore     Int?
  aiSummary           String?
  aiRecommendation    String? // strong_hire, hire, no_hire, not_enough_evidence
  durationSeconds     Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  set                 InterviewSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  responses           InterviewResponse[]
  proctoringLogs      ProctoringLog[]

  @@index([setId])
  @@index([status])
  @@index([candidateEmail])
}

model InterviewResponse {
  id                String   @id @default(cuid())
  sessionId         String
  questionId        String?
  order             Int
  question          String?
  responseText      String?
  responseAudioUrl  String?
  responseVideoUrl  String?
  responseDuration  Int?
  aiScore           Int?
  aiFeedback        String?
  followUpFromId    String?
  isFollowUp        Boolean  @default(false)
  isCvBased         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  followUpFrom      InterviewResponse?  @relation("ResponseFollowUp", fields: [followUpFromId], references: [id], onDelete: SetNull)
  followUps         InterviewResponse[]  @relation("ResponseFollowUp")

  @@index([sessionId])
  @@index([followUpFromId])
}

model ProctoringLog {
  id            String   @id @default(cuid())
  sessionId     String
  eventType     String   // tab_switch, face_not_detected, multiple_faces, audio_anomaly, copy_paste, ai_assistant_detected, browser_devtools
  severity      String   @default("low") // low, medium, high, critical
  details       String?
  timestamp     DateTime @default(now())
  screenshotUrl String?

  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([severity])
}

model InterviewInvitation {
  id                   String    @id @default(cuid())
  setId                String
  candidateEmail       String
  candidateName        String
  invitationToken      String    @unique
  invitationUrl        String?
  status               String    @default("pending") // pending, sent, opened, started, completed, expired, bounced
  sentAt               DateTime?
  openedAt             DateTime?
  expiresAt            DateTime?
  emailDeliveryStatus  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  set                  InterviewSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([invitationToken])
  @@index([status])
}

// ============ RBAC - ROLE & PERMISSION MANAGEMENT ============

model Role {
  id          String @id @default(cuid())
  name        String
  key         String  // unique key like 'hr_admin', 'manager', custom roles
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted
  level       Int     @default(0) // hierarchy level: 0=super_admin, 1=tenant_admin, etc.

  tenantId    String? // null for global/system roles (super_admin)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId   String? // null for tenant-level roles, set for company-specific roles
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  status      String  @default("active")
  createdBy   String? // userId who created this role

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@index([key])
}

model Module {
  id          String @id @default(cuid())
  key         String @unique // e.g. 'employees', 'recruitment', 'payroll'
  name        String // display name
  description String?
  category    String // group: 'Core HR', 'Talent', 'Operations', etc.
  icon        String? // icon name for UI
  sortOrder   Int    @default(0)

  permissions Permission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String @id @default(cuid())
  moduleId    String
  module      Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  action      String // 'view', 'create', 'edit', 'delete', 'export', 'approve'
  description String?

  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleId, action])
  @@index([moduleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  granted      Boolean @default(true) // true=grant, false=deny (for override)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String? // specific company scope

  assignedBy String? // userId who assigned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
}

// ============ ADVANCED PAYROLL MODULE - MULTI-CURRENCY, MULTI-COUNTRY, MULTI-DIMENSIONAL ============

// --- CTC Template & Component Mapping ---

model CTCTemplate {
  id               String   @id @default(cuid())
  name             String
  countryCode      String   @default("IND") // ISO 3166-1 alpha-3
  legalEntityId    String?  // NULL = applicable to all entities in country
  currencyCode     String   @default("INR") // ISO 4217
  ctcType          String   @default("ANNUAL") // ANNUAL, MONTHLY
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  version          Int      @default(1)
  status           String   @default("DRAFT") // DRAFT, ACTIVE, INACTIVE
  isDefault        Boolean  @default(false)
  basePayPct       Float?   // Default % of CTC allocated to base pay
  createdBy        String?
  companyId        String?  // Link to company for multi-tenant scope

  componentMappings CTCComponentMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([status])
  @@index([companyId])
}

model CTCComponentMapping {
  id                 String   @id @default(cuid())
  ctcTemplateId      String
  ctcTemplate        CTCTemplate @relation(fields: [ctcTemplateId], references: [id], onDelete: Cascade)
  componentId        String?  // FK to PayrollComponent
  componentName      String
  componentCategory  String   @default("EARNING") // EARNING, DEDUCTION, EMPLOYER_CONTRIBUTION, REIMBURSEMENT, BENEFIT_IN_KIND
  allocationMethod   String   @default("PERCENTAGE_OF_CTC") // PERCENTAGE_OF_CTC, FIXED_AMOUNT, PERCENTAGE_OF_COMPONENT, FORMULA, PRORATA
  allocationValue    Float    @default(0)
  baseComponentId    String?  // Reference component when allocationMethod = PERCENTAGE_OF_COMPONENT
  formulaExpression  String?  // Formula when allocationMethod = FORMULA
  calculationSequence Int     @default(1)
  isStatutory        Boolean  @default(false)
  isTaxable          Boolean  @default(true)
  taxExemptionLimit  Float?
  frequency          String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, ONCE, VARIABLE
  prorationRule      String?  // CALENDAR_DAYS, WORKING_DAYS, FIXED_MONTH
  minAmount          Float?
  maxAmount          Float?
  roundingRule       String?  // NEAREST, UP, DOWN, NEAREST_10, NEAREST_100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ctcTemplateId])
  @@index([calculationSequence])
}

// --- Payroll Component Master ---

model PayrollComponent {
  id                  String   @id @default(cuid())
  code                String   // Short code: BASIC, HRA, EPF_EE, PIT
  name                String
  componentType       String   // EARNING, DEDUCTION, EMPLOYER_CONTRIB, EMPLOYEE_CONTRIB, REIMBURSEMENT, BENEFIT_IN_KIND, INFORMATIONAL
  componentCategory   String   // NORMAL, STATUTORY
  countryCode         String   @default("IND")
  calculationType     String   // FLAT_AMOUNT, PERCENTAGE, SLAB_BASED, FORMULA, LOOKUP_TABLE, MANUAL_ENTRY
  defaultValue        Float?   // Default flat amount or percentage
  percentageBase      String?  // Component code of base for percentage calc
  formulaId           String?  // Reference to formula definition
  slabTableId         String?  // Reference to slab/rate table
  isTaxable           Boolean  @default(true)
  taxTreatment        String?  // FULLY_TAXABLE, PARTIALLY_TAXABLE, EXEMPT, DEFERRED
  exemptionSection    String?  // e.g. "80C", "80D", "401k"
  maxExemptionAmt     Float?
  affectsGross        Boolean  @default(true)
  affectsNet          Boolean  @default(true)
  affectsCTC          Boolean  @default(true)
  paymentFrequency    String   @default("MONTHLY") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL, ONE_TIME, VARIABLE
  prorationApplicable Boolean  @default(true)
  roundingRule        String?  // NEAREST, CEILING, FLOOR, NEAREST_10, NEAREST_100, BANKERS_ROUNDING
  isActive            Boolean  @default(true)
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  companyId           String?

  statutoryDetails    StatutoryComponent[]
  slabLines           TaxSlabRateLine[]
  glMappings          GLAccountMapping[]
  transactionLines    PayrollTransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, countryCode])
  @@index([countryCode])
  @@index([componentCategory])
  @@index([componentType])
  @@index([companyId])
}

// --- Statutory Components ---

model StatutoryComponent {
  id                  String   @id @default(cuid())
  componentId         String
  component           PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentCode       String
  componentName       String
  countryCode         String
  authorityName       String
  authorityCode       String?
  partyType           String   // EMPLOYEE, EMPLOYER, BOTH
  calculationBasis    String   // GROSS_PAY, BASIC_PAY, SPECIFIC_COMPONENT, SLAB_BASED, FLAT_RATE
  basisComponentId    String?  // Component ID when calculationBasis = SPECIFIC_COMPONENT
  ratePercentage      Float?   // Contribution rate %
  wageCeiling         Float?   // Maximum basis pay subject to contribution
  maxContributionAmt  Float?
  minContributionAmt  Float?
  slabTableId         String?
  remittanceFrequency String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, ON_DEMAND
  remittanceDueDay    Int?     // Day of month for remittance
  filingFrequency     String?  // MONTHLY, QUARTERLY, ANNUAL, HALF_YEARLY
  filingFormat        String?  // ECR, FPS, W-2, IR8A
  penaltyRatePct      Float?   // Penalty interest rate % per month
  isChallanRequired   Boolean  @default(false)
  challanFormat       String?
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([componentId])
  @@index([countryCode])
}

// --- Income Tax Slab Configuration ---

model TaxSlabTable {
  id              String   @id @default(cuid())
  name            String
  countryCode     String
  taxYear         String
  filingStatus    String?  // SINGLE, MARRIED_JOINT, MARRIED_SEPARATE, HEAD_OF_HOUSEHOLD, SENIOR_CITIZEN
  regimeType      String?  // OLD, NEW, STANDARD
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  companyId       String?

  rateLines       TaxSlabRateLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([taxYear])
}

model TaxSlabRateLine {
  id              String   @id @default(cuid())
  slabTableId     String
  slabTable       TaxSlabTable @relation(fields: [slabTableId], references: [id], onDelete: Cascade)
  sequence        Int
  incomeFrom      Float    @default(0)
  incomeTo        Float?   // NULL = no upper limit
  ratePercentage  Float    @default(0)
  fixedAmount     Float?   // Fixed tax for cumulative calc
  surchargeRate   Float?
  cessRate        Float?   // Health/Education cess %

  component       PayrollComponent? @relation(fields: [componentId], references: [id])
  componentId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slabTableId])
  @@index([sequence])
}

// --- Payroll Input Management ---

model PayrollInput {
  id                String   @id @default(cuid())
  payrollRunId      String?  // FK to PayrollRun
  payrollRun        PayrollRun? @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  inputType         String   // ATTENDANCE, LEAVE, OVERTIME, VARIABLE_PAY, ONE_TIME, REIMBURSEMENT, LOAN, INVESTMENT, TAX_ADJ, ORG_CHANGE
  componentCode     String
  inputValueNumeric Float?
  unitType          String?  // AMOUNT, DAYS, HOURS, PERCENTAGE
  inputDateFrom     DateTime?
  inputDateTo       DateTime?
  currencyCode      String?  @default("INR")
  exchangeRate      Float?
  approvalStatus    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy        String?
  approvalDate      DateTime?
  source            String   @default("MANUAL") // MANUAL, BULK_UPLOAD, API_INTEGRATION, SELF_SERVICE, SYSTEM_GENERATED
  referenceDocument String?
  remarks           String?
  createdBy         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([payrollRunId])
  @@index([inputType])
  @@index([approvalStatus])
}

// --- Multi-Currency Processing ---

model CurrencyConfig {
  id                  String   @id @default(cuid())
  legalEntityId       String
  baseCurrency        String   @default("INR")
  payrollCurrency     String   @default("INR")
  reportingCurrency   String?
  exchangeRateSource  String   @default("MANUAL") // CENTRAL_BANK, REUTERS, BLOOMBERG, MANUAL, CUSTOM_API
  rateType            String   @default("SPOT") // SPOT, MONTHLY_AVERAGE, CUSTOM, CONTRACTUAL
  autoFetchEnabled    Boolean  @default(false)
  fetchFrequency      String?  // DAILY, WEEKLY, MONTHLY, ON_DEMAND
  roundingPrecision   Int      @default(2)
  roundingRule        String   @default("NEAREST") // NEAREST, UP, DOWN, BANKERS
  gainLossAccount     String?  // GL account for exchange rate gains/losses
  companyId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalEntityId])
  @@index([companyId])
}

model ExchangeRate {
  id              String   @id @default(cuid())
  fromCurrency    String
  toCurrency      String
  exchangeRate    Float
  rateDate        DateTime
  rateType        String   @default("SPOT") // SPOT, MONTHLY_AVERAGE, QUARTERLY_AVERAGE, CUSTOM, CONTRACTUAL
  source          String   @default("Manual Entry")
  inverseRate     Float?
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromCurrency, toCurrency, rateDate])
  @@index([isActive])
}

// --- Multi-Dimensional Allocation ---

model DimensionDefinition {
  id                String   @id @default(cuid())
  code              String   // DEPT, CC, PROJ, LOC, BU
  name              String
  dimensionType     String   @default("STANDARD") // STANDARD, CUSTOM
  hierarchyEnabled  Boolean  @default(false)
  allocationMethod  String   @default("PERCENTAGE") // PERCENTAGE, AMOUNT, HEADCOUNT, FTE
  isMandatory       Boolean  @default(false)
  allowMultiple     Boolean  @default(true)
  maxAllocations    Int?
  effectiveFrom     DateTime @default(now())
  companyId         String?

  allocations       EmployeeDimensionAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([companyId])
}

model EmployeeDimensionAllocation {
  id               String   @id @default(cuid())
  employeeId       String
  dimensionId      String
  dimension        DimensionDefinition @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  dimensionValueId String   // e.g. Department = "Engineering", CC = "CC-1001"
  allocationPct    Float    @default(100)
  allocationAmount Float?
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  isPrimary        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([dimensionId])
}

// --- Payroll Run (Processing Workflow) ---

model PayrollRun {
  id                  String   @id @default(cuid())
  legalEntityId       String
  payrollPeriod       String   // e.g. "2026-06"
  periodStartDate     DateTime
  periodEndDate       DateTime
  payDate             DateTime
  runType             String   @default("REGULAR") // REGULAR, OFF_CYCLE, SUPPLEMENTAL, FINAL_SETTLEMENT, CORRECTION
  runStatus           String   @default("OPEN") // OPEN, INPUT_COLLECTION, PROCESSING, REVIEW, APPROVED, ACCOUNTING, DISBURSED, CLOSED
  currencyCode        String   @default("INR")
  exchangeRateDate    DateTime?
  taxProjectionMethod String   @default("CUMULATIVE") // CUMULATIVE, NON_CUMULATIVE, ANNUALIZED
  includeStatutory    Boolean  @default(true)
  processingMode      String   @default("FULL") // FULL, DELTA
  initiatedBy         String?
  companyId           String?
  totalEmployees      Int      @default(0)
  totalGrossPay       Float    @default(0)
  totalDeductions     Float    @default(0)
  totalNetPay         Float    @default(0)
  totalEmployerContrib Float   @default(0)

  // Lock / approval / audit trail (REQ-PAY-07, REQ-7.2, REQ-SEC-PAY-02/03, REQ-AI-PAY-01/03)
  lockRequests         PayrollLockRequest[]
  approvals            PayrollApproval[]
  anomalies            PayrollAnomaly[]
  ghostEmployeeFlags   GhostEmployeeFlag[]
  company              Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  transactionLines    PayrollTransactionLine[]
  payrollInputs       PayrollInput[]
  complianceFilings   ComplianceFiling[]
  bankPaymentFiles    BankPaymentFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([legalEntityId, payrollPeriod, runType])
  @@index([runStatus])
  @@index([companyId])
  @@index([payrollPeriod])
}

// --- Payroll Transaction Line ---

model PayrollTransactionLine {
  id                    String   @id @default(cuid())
  payrollRunId          String
  payrollRun            PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId           String?
  component             PayrollComponent? @relation(fields: [componentId], references: [id])
  componentCode         String
  componentType         String   // EARNING, DEDUCTION, EMPLOYER_CONTRIB, EMPLOYEE_CONTRIB, REIMBURSEMENT, INFO
  componentCategory     String   // NORMAL, STATUTORY
  calculatedAmount      Float    @default(0)
  overrideAmount        Float?
  finalAmount           Float    @default(0)
  currencyCode          String   @default("INR")
  exchangeRate          Float?
  baseCurrencyAmount    Float?
  ytdAmount             Float    @default(0)
  mtdAmount             Float    @default(0)
  prorationFactor       Float?   // 1.0 = full period
  inputSourceId         String?
  formulaTrace          String?  // JSON trace for audit
  dimensionSplitJson    String?  // JSON: {"DEPT": {"ENG": 0.6, "SALES": 0.4}}
  glAccountCode         String?
  costCenterCode        String?
  isReversal            Boolean  @default(false)
  reversedTransactionId String?
  taxTreatment          String?  // FULLY_TAXABLE, PARTIALLY_TAXABLE, EXEMPT, PRE_TAX, POST_TAX
  statutoryReference    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([componentCode])
  @@index([componentType])
}

// --- Compliance Management ---

model ComplianceObligation {
  id                  String   @id @default(cuid())
  name                String
  countryCode         String
  authorityName       String
  filingType          String   // RETURN, CHALLAN, CERTIFICATE, REGISTRATION, REPORT, DECLARATION
  frequency           String   // MONTHLY, QUARTERLY, HALF_YEARLY, ANNUAL, ONE_TIME
  dueDateRule         String   // e.g. "D+15" = 15th of following month
  graceDays           Int?
  penaltyType         String?  // FIXED_AMOUNT, PERCENTAGE_PER_DAY, PERCENTAGE_PER_MONTH, PROGRESSIVE
  penaltyValue        Float?
  responsibleRole     String   @default("PAYROLL_ADMIN")
  escalationRole      String?
  reminderDaysBefore  String?  // Comma-separated: "7,3,1"
  autoGenerate        Boolean  @default(false)
  filingFormat        String?
  isActive            Boolean  @default(true)
  companyId           String?

  filings             ComplianceFiling[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([isActive])
  @@index([companyId])
}

model ComplianceFiling {
  id                  String   @id @default(cuid())
  complianceId        String
  compliance          ComplianceObligation @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  payrollRunId        String?
  payrollRun          PayrollRun? @relation(fields: [payrollRunId], references: [id])
  filingPeriod        String
  filingStatus        String   @default("GENERATED") // GENERATED, UNDER_REVIEW, SUBMITTED, ACKNOWLEDGED, REJECTED, PENALTY_APPLIED
  generatedDate       DateTime @default(now())
  submittedDate       DateTime?
  acknowledgementRef  String?
  filingAmount        Float?
  penaltyAmount       Float?
  filePath            String?
  submittedBy         String?
  reviewedBy          String?
  rejectionReason     String?
  resubmissionDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceId])
  @@index([filingStatus])
  @@index([filingPeriod])
}

// --- GL Account Mapping ---

model GLAccountMapping {
  id                  String   @id @default(cuid())
  legalEntityId       String
  componentId         String
  component           PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  debitAccount        String
  creditAccount       String
  costCenterSource    String   @default("EMPLOYEE_DEFAULT") // EMPLOYEE_DEFAULT, COMPONENT_SPECIFIC, DIMENSION_SPLIT
  specificCostCenter  String?
  postingType         String   @default("ACTUAL") // ACCRUAL, ACTUAL, BOTH
  intercompanyAccount String?
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  companyId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalEntityId])
  @@index([componentId])
  @@index([companyId])
}

// ============ INDIAN PAYROLL - ADDITIONAL MODELS ============

// Payroll Definition - Pay frequency, cut-off dates, payment methods at payroll level
model PayrollDefinition {
  id                String   @id @default(cuid())
  name              String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payFrequency      String   @default("MONTHLY") // DAILY, WEEKLY, BI_WEEKLY, SEMI_MONTHLY, MONTHLY, QUARTERLY, SEMI_ANNUALLY, ANNUALLY
  processingCutOff  Int      @default(25) // Day of month for processing cut-off
  paymentDay        Int      @default(1) // Day of month for payment
  currencyCode      String   @default("INR")
  countryCode       String   @default("IN")

  // Allowed payment methods for this payroll
  allowDirectDeposit Boolean  @default(true)
  allowCheque        Boolean  @default(false)
  allowCash          Boolean  @default(false)

  // Costing segments
  costingSegments    String?  // JSON: e.g. ["department","cost_center","location"]

  status             String   @default("active") // active, inactive
  effectiveFrom      DateTime @default(now())
  effectiveTo        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// Employee Payment Method - Bank details with split payment support
model EmployeePaymentMethod {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  paymentType       String   @default("DIRECT_DEPOSIT") // DIRECT_DEPOSIT, CHEQUE, CASH
  bankName          String?
  bankAccountNo     String?
  bankIfscCode      String?
  bankBranch        String?
  accountType       String?  // SAVINGS, CURRENT, SALARY
  currencyCode      String   @default("INR")

  // Split payment support (multiple accounts)
  splitType         String?  // PERCENTAGE, FIXED_AMOUNT
  splitValue        Float?   // Percentage or fixed amount for this method
  isPrimary         Boolean  @default(true)
  priority          Int      @default(1)

  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  status            String   @default("active") // active, inactive

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// Loan Management - Full loan lifecycle
model Loan {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  loanType          String   // PERSONAL, EMERGENCY, HOUSING, VEHICLE, EDUCATION, FESTIVAL, OTHER
  loanAmount        Float
  interestRate      Float    @default(0)
  tenureMonths      Int
  emiAmount         Float
  outstandingBalance Float
  disbursedAmount   Float
  disbursedDate     DateTime?
  startDate         DateTime
  endDate           DateTime?
  recoveredAmount   Float    @default(0)
  remainingEmis     Int

  status            String   @default("pending") // pending, approved, active, completed, cancelled, defaulted
  approvedBy        String?
  approvedAt        DateTime?

  // Recovery tracking
  recoverySchedule  String?  // JSON: array of {month, year, amount, status}

  remarks           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([loanType])
}

// Overtime Management
model OvertimeRecord {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date              DateTime
  hours             Float    @default(0)
  rateType          String   @default("FLAT") // FLAT, PERCENTAGE_OF_BASIC, HOURLY_RATE
  rate              Float    @default(0)
  amount            Float    @default(0)

  reason            String?
  project           String?
  approvedBy        String?
  approvedAt        DateTime?
  status            String   @default("pending") // pending, approved, rejected, processed

  payrollRunId      String?  // Linked to payroll run when processed

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([status])
  @@index([date])
}

// Payroll Hold - Hold/suspend employee payroll
model PayrollHold {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  holdType          String   // FULL_HOLD, PARTIAL_HOLD, DEDUCTION_ONLY
  reason            String
  holdFromPeriod    String   // e.g. "2026-06"
  holdToPeriod      String?  // NULL = indefinite
  heldComponents    String?  // JSON array of component codes to hold (for partial hold)

  releasedDate      DateTime?
  releasedBy        String?
  status            String   @default("active") // active, released, cancelled

  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// Bank Payment File - Generated bank files for salary disbursement
model BankPaymentFile {
  id                String   @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  fileName          String
  fileFormat        String   @default("NACH") // NACH, NEFT, RTGS, CUSTOM
  bankCode          String?
  totalAmount       Float    @default(0)
  totalRecords      Int      @default(0)
  fileContent       String?  // Base64 encoded or JSON

  generatedBy       String?
  generatedAt       DateTime @default(now())
  status            String   @default("generated") // generated, submitted, acknowledged, rejected

  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([payrollRunId])
  @@index([status])
  @@index([companyId])
}

// Pre-Payroll Validation Result
model PayrollValidation {
  id                String   @id @default(cuid())
  payrollRunId      String?
  companyId         String?

  validationType    String   // PRE_PAYROLL, POST_PAYROLL
  status            String   @default("pending") // pending, completed, failed

  // Validation results as JSON
  missingPaymentMethods  String?  // JSON array of employee IDs
  missingSalaryBasis     String?  // JSON array of employee IDs
  heldEmployees          String?  // JSON array of employee IDs
  newJoiners             String?  // JSON array of employee IDs
  terminations           String?  // JSON array of employee IDs
  errors                 String?  // JSON array of error objects
  warnings               String?  // JSON array of warning objects

  totalEmployees     Int      @default(0)
  validEmployees     Int      @default(0)
  invalidEmployees   Int      @default(0)

  runBy              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([payrollRunId])
  @@index([companyId])
}

// ============ INCOME TAX DECLARATION ============

model IncomeTaxDeclaration {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  financialYear     String   // e.g. "2024-25"
  regimeType        String   @default("NEW") // OLD, NEW

  // Section 80C
  section80C_PPF            Float @default(0)
  section80C_ELSS           Float @default(0)
  section80C_LIC            Float @default(0)
  section80C_HomeLoanPrincipal Float @default(0)
  section80C_Other          Float @default(0)
  section80C_Total          Float @default(0)

  // Section 80D
  section80D_Self           Float @default(0)
  section80D_Parents        Float @default(0)
  section80D_Total          Float @default(0)

  // Section 80CCD
  section80CCD_NPS          Float @default(0)

  // Section 24(b)
  section24b_HomeLoanInterest Float @default(0)

  // HRA
  hra_ActualHRA             Float @default(0)
  hra_RentPaid              Float @default(0)
  hra_IsMetro               Boolean @default(false)
  hra_ExemptionCalc         Float @default(0)

  // Other
  section80E_EducationLoan  Float @default(0)
  section80G_Donations      Float @default(0)
  section80TTA_SavingsInterest Float @default(0)
  otherDeductions           Float @default(0)

  // Computed
  totalDeductions           Float @default(0)
  taxableIncome             Float @default(0)
  estimatedTax              Float @default(0)

  // Status
  status                    String @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  submittedAt               DateTime?
  reviewedBy                String?
