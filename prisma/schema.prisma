// ============ TENANT CONFIGURATION — COUNTRY / CURRENCY / LANGUAGE / POLICY ACCESS ============
//
// Super admin configures which countries, currencies, and languages a tenant can access.
// Based on the selected countries, payroll policies, compliance obligations, tax slabs,
// and minimum wage configs are auto-provisioned. Tenant admin can then edit or create
// new policies within their allowed scope.
//
// This drives the costing model: more countries = more compliance/policy coverage = higher cost.

/// Master record — one per tenant. Holds the overall tenant config envelope.
model TenantConfiguration {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auto-provisioning toggle: when super admin adds a new country, the system
  // auto-creates default payroll policies, compliance obligations, tax slabs,
  // and minimum wage configs for that country.
  autoProvisionPayroll  Boolean @default(true)
  autoProvisionCompliance Boolean @default(true)
  autoProvisionTaxSlabs Boolean @default(true)
  autoProvisionMinWage  Boolean @default(true)

  // Costing metadata (populated / updated when countries/currencies are added/removed)
  activeCountryCount    Int     @default(0)
  activeCurrencyCount   Int     @default(0)
  activeLanguageCount   Int     @default(0)
  estimatedMonthlyCost  Float   @default(0)
  estimatedAnnualCost   Float   @default(0)

  // Customisation tier: controls how much the tenant admin can override
  // 'standard' = can only use pre-configured policies; 'custom' = can create
  // new policies; 'full' = can modify everything including tax slabs.
  customisationTier     String  @default("standard") // standard, custom, full

  // User/company quota — set by super admin, drives costing
  maxUsers              Int     @default(50)
  maxCompanies          Int     @default(5)
  maxEmployees          Int     @default(500)

  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries   TenantCountryAccess[]
  currencies  TenantCurrencyAccess[]
  languages   TenantLanguageAccess[]
  policies    TenantPayrollPolicy[]

  @@index([tenantId])
}

/// Per-country access record. Super admin grants country access;
/// system auto-provisions country-specific payroll defaults.
model TenantCountryAccess {
  id            String   @id @default(cuid())
  tenantConfigId String
  tenantConfig  TenantConfiguration @relation(fields: [tenantConfigId], references: [id], onDelete: Cascade)

  countryCode   String   // ISO 3166-1 alpha-2 (e.g. IN, US, GB, AE)
  countryName   String   // Human-readable (India, United States, …)
  isActive      Boolean  @default(true)

  // When this country was granted — used for audit / billing start date
  accessGrantedAt DateTime @default(now())

  // Auto-provisioned defaults for this country (set when autoProvisionPayroll = true)
  // The system pre-creates: payroll frequency, statutory components, tax slabs,
  // compliance obligations, minimum wage configs — all specific to this country.
  payrollFrequencyDefault  String  @default("MONTHLY") // DAILY, WEEKLY, BI_WEEKLY, SEMI_MONTHLY, MONTHLY
  payrollCurrencyDefault   String  // Auto-set based on country (INR for India, USD for US, etc.)
  taxRegimeDefault         String? // OLD, NEW, STANDARD, PROGRESSIVE — country-specific
  workingHoursPerWeek      Int     @default(40)
  workingDaysPerWeek       Int     @default(5)
  overtimeMultiplier       Float   @default(1.5)

  // Compliance flags
  pfEnabled      Boolean @default(false)  // Provident Fund (India-specific)
  esiEnabled     Boolean @default(false)  // Employee State Insurance (India)
  gratuityEnabled Boolean @default(false) // Gratuity (India, UAE)
  socialSecurityEnabled Boolean @default(false) // Social Security (US, EU, etc.)
  pensionEnabled Boolean @default(false)  // Pension schemes (UK, JP, etc.)
  medicaidEnabled Boolean @default(false) // Medical aid (ZA, etc.)

  // Labour law compliance
  labourLawCode   String? // Reference to applicable labour law (e.g. " Shops & Establishments Act" for India)
  terminationNoticePeriod Int @default(30) // Days
  probationPeriod Int     @default(180) // Days
  annualLeaveEntitlement Float @default(15) // Days per year

  // Data residency requirement for this country
  dataResidencyRequired  Boolean @default(false)
  dataResidencyRegion    String? // e.g. "eu-west-1", "ap-south-1"

  // Tenant admin can override these within their customisation tier
  isOverridden   Boolean @default(false) // Whether tenant admin has modified any defaults
  overrideNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantConfigId, countryCode])
  @@index([tenantConfigId])
  @@index([countryCode])
  @@index([isActive])
}

/// Per-currency access record. Super admin grants currency access;
/// this drives multi-currency payroll and exchange rate features.
model TenantCurrencyAccess {
  id            String   @id @default(cuid())
  tenantConfigId String
  tenantConfig  TenantConfiguration @relation(fields: [tenantConfigId], references: [id], onDelete: Cascade)

  currencyCode  String   // ISO 4217 (INR, USD, EUR, GBP, etc.)
  currencyName  String   // Indian Rupee, US Dollar, etc.
  currencySymbol String  // ₹, $, €, £, etc.
  isActive      Boolean  @default(true)

  // Exchange rate config
  exchangeRateSource   String  @default("MANUAL") // CENTRAL_BANK, REUTERS, BLOOMBERG, MANUAL, CUSTOM_API
  autoFetchEnabled     Boolean @default(false)
  fetchFrequency       String? // DAILY, WEEKLY, MONTHLY, ON_DEMAND
  lastFetchedRate      Float?
  lastFetchedAt        DateTime?

  // Rounding rules
  roundingPrecision    Int     @default(2)
  roundingRule         String  @default("NEAREST") // NEAREST, UP, DOWN, BANKERS

  // GL integration
  gainLossAccount      String? // GL account for exchange rate gains/losses

  // Costing: currency access has per-currency monthly cost
  monthlyCostPerCurrency Float @default(0)

  isOverridden   Boolean @default(false)
  overrideNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantConfigId, currencyCode])
  @@index([tenantConfigId])
  @@index([currencyCode])
  @@index([isActive])
}

/// Per-language access record. Super admin grants language access;
/// this drives UI localisation and document generation in that language.
model TenantLanguageAccess {
  id            String   @id @default(cuid())
  tenantConfigId String
  tenantConfig  TenantConfiguration @relation(fields: [tenantConfigId], references: [id], onDelete: Cascade)

  languageCode  String   // ISO 639-1 (en, hi, es, fr, de, ar, etc.)
  languageName  String   // English, Hindi, Spanish, French, etc.
  isActive      Boolean  @default(true)

  // Localisation depth
  uiTranslated       Boolean @default(false) // UI fully translated?
  documentTemplates  Boolean @default(false) // Payslips, offer letters etc. available?
  emailTemplates     Boolean @default(false) // Notification emails available?
  helpArticles       Boolean @default(false) // Help documentation available?

  // Right-to-left support
  isRTL         Boolean @default(false) // Arabic, Hebrew, etc.

  isOverridden   Boolean @default(false)
  overrideNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantConfigId, languageCode])
  @@index([tenantConfigId])
  @@index([languageCode])
  @@index([isActive])
}

/// Tenant-specific payroll policy — pre-configured by system when country is added,
/// editable by tenant admin (within their customisation tier).
/// These cascade to companies under the tenant but can be overridden at company level.
model TenantPayrollPolicy {
  id              String   @id @default(cuid())
  tenantConfigId  String
  tenantConfig    TenantConfiguration @relation(fields: [tenantConfigId], references: [id], onDelete: Cascade)

  countryCode     String   // Which country this policy applies to
  countryName     String?

  // Policy identification
  policyName      String
  policyType      String   // PAYROLL_FREQUENCY, TAX_REGIME, STATUTORY_COMPLIANCE, LEAVE_POLICY,
                           // OVERTIME_POLICY, GRATUITY_POLICY, PROBATION_POLICY, TERMINATION_POLICY,
                           // MINIMUM_WAGE, WORKING_HOURS, SOCIAL_SECURITY, PENSION, MEDICAL_AID,
                           // CUSTOM
  category        String   // payroll, leave, compliance, benefits, labour_law, custom

  // Policy content — JSON payload with all the configuration details
  // Structure varies by policyType. Examples:
  // PAYROLL_FREQUENCY: {"frequency":"MONTHLY","processingDay":25,"paymentDay":1,"cutOffDay":20}
  // TAX_REGIME: {"regimeType":"NEW","slabTableId":"...","deductionsAllowed":true}
  // STATUTORY_COMPLIANCE: {"components":["PF","ESI","PT"],"filingFrequency":"MONTHLY"}
  // LEAVE_POLICY: {"annualLeave":15,"sickLeave":10,"casualLeave":7,"carryForward":true,"maxCarryForward":5}
  // OVERTIME_POLICY: {"multiplier":1.5,"maxOTHoursPerWeek":12,"compOffEnabled":true}
  // GRADUITY_POLICY: {"eligibleAfterYears":5,"calculationBasis":"LAST_DRAWN","multiplier":15/26}
  // PROBATION_POLICY: {"durationDays":180,"extendable":true,"maxExtensionDays":90}
  // TERMINATION_POLICY: {"noticePeriodDays":30,"paymentInLieu":true,"fnfTimelineDays":30}
  policyContent   String   // JSON string

  // Policy metadata
  source          String   @default("system_default") // system_default, tenant_override, custom
  status          String   @default("active") // active, inactive, draft
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?

  // Versioning
  version         String   @default("1.0")
  previousVersionId String? // Link to the previous version for audit trail

  // Tenant admin can edit within customisationTier
  isEditable      Boolean  @default(true) // Whether tenant admin can modify this policy
  isOverridden    Boolean  @default(false) // Whether tenant admin has modified it
  overrideHistory String?  // JSON array of previous overrides for audit

  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantConfigId])
  @@index([countryCode])
  @@index([policyType])
  @@index([status])
  @@index([source])
}

// ============ ADDITIONAL MODELS (Seeding gap fills) ============
// These models bridge the gap between the check-tenant-seed-status.py
// monitoring script and the Prisma schema. They represent business entities
// that are commonly expected in a full HRMS deployment but were previously
// referenced only implicitly or through other models.

// ─── BankAccount ───
// Stores employee bank account details for payroll processing.
// Distinct from EmployeePaymentMethod (which handles payment routing and split
// configurations). BankAccount is the authoritative record of an employee's
// actual bank accounts, used for verification, compliance, and direct deposit.
model BankAccount {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Account holder information
  accountHolderName  String
  bankName           String
  accountNumber      String
  confirmAccountNumber String?
  ifscCode           String?
  micrCode           String?
  branchName         String?
  branchAddress      String?

  // Account classification
  accountType        String   @default("savings") // savings, current, salary, nre, nro
  currency           String   @default("INR")

  // Verification & compliance
  isVerified         Boolean  @default(false)
  verifiedBy         String?  // userId of who verified
  verifiedAt         DateTime?
  verificationDoc    String?  // URL to cancelled cheque / bank statement

  // Status & priority
  status             String   @default("active") // active, inactive, closed, pending_verification
  isPrimary          Boolean  @default(false)

  // Effective dates for account changes
  effectiveFrom      DateTime @default(now())
  effectiveTo        DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, accountNumber, ifscCode])
  @@index([employeeId])
  @@index([isPrimary])
  @@index([status])
}

// ─── GratuityLedger ───
// Tracks gratuity accumulation for each employee per financial year.
// Required for Indian payroll compliance under the Payment of Gratuity Act, 1972.
// Each ledger entry records the annual gratuity provision, employer contributions,
// and any withdrawals or adjustments.
model GratuityLedger {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Financial period
  financialYear   String   // e.g., "2025-26", "2026-27"
  month           Int      @default(1)  // Month within the financial year (1-12)

  // Gratuity calculation inputs
  lastDrawnBasicSalary   Float @default(0)
  lastDrawnDA            Float @default(0)  // Dearness Allowance
  yearsOfService         Float @default(0)  // Total completed years (can be fractional)
  completedYears         Int   @default(0)  // Rounded down completed years for eligibility

  // Gratuity amount computation
  // Formula: Last Drawn (Basic + DA) × 15/26 × Years of Service
  monthlyProvision       Float @default(0)  // Monthly provision amount
  accumulatedProvision   Float @default(0)  // Cumulative provision for the FY
  gratuityEarned         Float @default(0)  // Total gratuity earned till date
  employerContribution   Float @default(0)  // Employer's actual contribution (may differ from provision)

  // Adjustments & withdrawals
  adjustments            Float @default(0)  // Any adjustments (positive or negative)
  withdrawalAmount       Float @default(0)  // Amount withdrawn (on exit/claim)
  balanceAfterWithdrawal Float @default(0)  // Remaining balance after withdrawal

  // Eligibility & compliance
  isEligible             Boolean @default(false) // 5+ years completed
  eligibilityDate        DateTime?              // Date when 5-year eligibility kicks in
  lastDrawnSalaryDate    DateTime?              // Date of last salary used for calculation

  // Status
  status                 String @default("provisioned") // provisioned, claimed, partially_claimed, lapsed
  processedAt            DateTime?
  processedBy            String?  // userId

  currency               String @default("INR")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, financialYear, month])
  @@index([employeeId])
  @@index([companyId])
  @@index([financialYear])
  @@index([status])
}

// ─── Setting ───
// General-purpose key-value settings store for tenant and company-level
// configurations. Covers settings that don't warrant their own dedicated
// model — e.g., UI preferences, feature toggles, integration configs,
// notification preferences, approval thresholds, etc.
// Supports hierarchical lookup: tenant > company scope.
model Setting {
  id          String   @id @default(cuid())

  // Scope: either tenant-level or company-level
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?  // null = tenant-wide setting
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Setting identification
  category    String   // e.g., "general", "leave", "attendance", "payroll", "recruitment",
                       // "notification", "approval", "integration", "ui", "security"
  key         String   // e.g., "default_leave_carry_forward", "auto_approve_leave_days"
  value       String   // JSON-serialized value (string, number, boolean, object, array)
  dataType    String   @default("string") // string, number, boolean, json, array

  // Metadata
  description String?
  isEditable  Boolean  @default(true)  // Whether tenant/company admin can modify
  isSecret    Boolean  @default(false) // Whether value is encrypted/sensitive (API keys, etc.)
  defaultValue String? // Fallback value if current value is removed

  // Versioning
  version     Int      @default(1)
  previousValue String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, companyId, category, key])
  @@index([tenantId])
  @@index([companyId])
  @@index([category])
  @@index([key])
}

// ─── Candidate ───
// Standalone candidate profile for the recruitment pipeline.
// Represents a person who has applied or been sourced, independent of any
// specific job application. A Candidate can have multiple JobApplications
// across different JobPostings. This model centralizes candidate PII,
// skills, and status so that recruitment teams can manage a talent pool.
model Candidate {
  id          String   @id @default(cuid())

  // Ownership
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?  // Primary company sourcing this candidate
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Personal information
  firstName   String
  lastName    String
  email       String
  phone       String?
  avatar      String?

  // Professional profile
  currentJobTitle    String?
  currentCompany     String?
  currentLocation    String?
  totalExperience    Float?   // In years
  noticePeriod       Int?     // In days
  currentCTC         Float?
  expectedCTC        Float?
  currency           String   @default("INR")

  // Skills & education
  skills             String?  // Comma-separated or JSON array
  highestQualification String?
  university         String?
  graduationYear     Int?

  // Sourcing
  source             String   @default("direct") // direct, referral, job_board, linkedin, naukri, indeed, internal, campus, agency
  sourceDetails      String?  // Additional source metadata (e.g., referral employee ID)
  recruiterId        String?  // Employee ID of recruiter who sourced

  // Resume & documents
  resumeUrl          String?
  coverLetterUrl     String?
  linkedinUrl        String?
  portfolioUrl       String?

  // Status in pipeline
  status             String   @default("new") // new, screening, shortlisted, interviewing,
                                               // offered, hired, rejected, on_hold, warm_pool, talent_pool
  subStatus          String?  // More granular status within a stage

  // AI-driven fields
  aiMatchScore       Float?   // 0-100, computed by AI resume matching
  aiSentimentScore   Float?   // Sentiment from interactions
  aiRecommendedRole  String?  // AI-suggested role based on profile

  // Communication tracking
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  communicationCount Int      @default(0)

  // Tags & categorization
  tags               String?  // JSON array of tags
  category           String?  // e.g., "engineering", "sales", "leadership"
  pool               String?  // Talent pool assignment

  // Important dates
  appliedAt          DateTime?
  hiredAt            DateTime?
  rejectedAt         DateTime?

  // GDPR & consent
  consentGiven       Boolean  @default(false)
  consentDate        DateTime?
  dataRetentionDays  Int      @default(730) // Default 2 years
  anonymized         Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobApplications    JobApplication[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@index([source])
  @@index([aiMatchScore])
}

// ─── CompanyPolicy ───
// Company-specific policy documents that extend the base Policy model.
// While Policy is generic and company-scoped, CompanyPolicy adds document
// management, acknowledgement tracking, and compliance features required
// for HR policy distribution and employee attestation.
model CompanyPolicy {
  id          String   @id @default(cuid())

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Policy identification
  title       String
  policyCode  String?  // Unique code for reference (e.g., "HR-LEAVE-001")
  category    String   // hr, it, safety, leave, travel, code_of_conduct, anti_harassment,
                        // data_security, remote_work, dress_code, disciplinary, compensation

  // Content
  description String?
  content     String?  // Full policy content (markdown or rich text)
  documentUrl String?  // Link to uploaded policy document (PDF, DOCX)

  // Versioning & lifecycle
  version     String   @default("1.0")
  previousVersionId String? // Link to previous version for audit trail
  status      String   @default("draft") // draft, active, under_review, archived, superseded
  effectiveDate   DateTime?
  reviewDate      DateTime?  // Scheduled review date
  expiryDate      DateTime?

  // Authorship & ownership
  authoredBy  String?  // Employee ID of policy author
  ownedBy     String?  // Employee ID of policy owner (responsible for updates)
  approvedBy  String?  // Employee ID of approver
  approvedAt  DateTime?

  // Acknowledgement & compliance
  requiresAcknowledgement Boolean @default(true)
  acknowledgementDeadlineDays Int? // Days within which employees must acknowledge
  totalAcknowledged       Int     @default(0)  // Count of employees who acknowledged
  totalPending            Int     @default(0)  // Count of employees yet to acknowledge

  // Distribution
  applicableTo  String @default("all_employees") // all_employees, specific_department, specific_designation, specific_location, new_hires
  departmentIds String? // JSON array of department IDs (if applicableTo is specific_department)
  designationIds String? // JSON array of designation IDs
  locationIds   String? // JSON array of branch IDs

  // Compliance flags
  isRegulatory  Boolean @default(false) // Whether this is mandated by law/regulation
  regulationRef String? // Reference to the regulation (e.g., "POSH Act 2013", "GDPR Article 22")
  penaltyForNonCompliance String? // Description of penalties

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, policyCode])
  @@index([companyId])
  @@index([category])
  @@index([status])
  @@index([effectiveDate])
}

// ============ COLLABORATION PRODUCTIVITY MODULES ============

// ─── Calendar Events ───────────────────────────────────────
model CalendarEvent {
  id            String   @id @default(cuid())
  title         String
  description   String?
  eventType     String   @default("meeting") // meeting | leave | holiday | birthday | training | anniversary
  startDateTime DateTime
  endDateTime   DateTime
  isAllDay      Boolean  @default(false)
  location      String?
  color         String?  // hex color
  createdBy     String
  creator       Employee @relation("CalendarEvent_Creator", fields: [createdBy], references: [id], onDelete: Cascade)
  companyId     String?
  attendees     String?  // JSON array of employee IDs
  recurrence    String?  // JSON: { freq: "weekly", interval: 1, until: "2026-12-31" }
  isPublic      Boolean  @default(true)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdBy])
  @@index([startDateTime])
  @@index([companyId])
}

// ─── Email Messages ───────────────────────────────────────
model EmailMessage {
  id            String   @id @default(cuid())
  subject       String
  body          String
  fromAddress   String
  fromName      String?
  toAddresses   String   // JSON array
  ccAddresses   String?  // JSON array
  bccAddresses  String?  // JSON array
  folder        String   @default("inbox") // inbox | sent | drafts | starred | archive | trash
  isRead        Boolean  @default(false)
  isStarred     Boolean  @default(false)
  hasAttachments Boolean @default(false)
  attachments   String?  // JSON array of { name, size, type, url }
  labels        String?  // JSON array of label strings
  senderId      String?  // Employee ID if internal
  sender        Employee? @relation("EmailMessage_Sender", fields: [senderId], references: [id], onDelete: SetNull)
  threadId      String?  // For conversation threading
  repliedToId   String?  // ID of email this replies to
  priority      String   @default("normal") // low | normal | high | urgent
  companyId     String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([folder])
  @@index([senderId])
  @@index([isRead])
  @@index([threadId])
  @@index([companyId])
}

// ─── Todo Tasks ────────────────────────────────────────────
model TodoTask {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("Medium") // High | Medium | Low
  status        String   @default("Pending") // Pending | In Progress | Completed | Overdue
  category      String?  // HR | Finance | Recruitment | Training | Operations | Compliance | IT | General
  dueDate       DateTime?
  assignedToId  String?
  assignee      Employee? @relation("TodoTask_Assignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById   String
  creator       Employee @relation("TodoTask_Creator", fields: [createdById], references: [id], onDelete: Cascade)
  companyId     String?
  completedAt   DateTime?
  subtasks      String?  // JSON array of { title, completed: bool }
  tags          String?  // JSON array of tag strings
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([companyId])
}

// ─── Notes ─────────────────────────────────────────────────
model Note {
  id            String   @id @default(cuid())
  title         String
  content       String
  category      String   @default("personal") // hr | meeting | policy | personal
  color         String   @default("#3B82F6") // hex color for card
  isPinned      Boolean  @default(false)
  createdById   String
  creator       Employee @relation("Note_Creator", fields: [createdById], references: [id], onDelete: Cascade)
  companyId     String?
  tags          String?  // JSON array
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
  @@index([category])
  @@index([companyId])
}

// ─── Social Feed Posts ─────────────────────────────────────
model SocialPost {
  id            String   @id @default(cuid())
  content       String
  postType      String   @default("general") // announcement | achievement | birthday | welcome | policy | event | general
  authorId      String
  author        Employee @relation("SocialPost_Author", fields: [authorId], references: [id], onDelete: Cascade)
  companyId     String?
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  sharesCount  Int      @default(0)
  attachments   String?  // JSON array of { type, url, name }
  hashtags      String?  // JSON array
  isPinned      Boolean  @default(false)
  isActive      Boolean  @default(true)
  comments      SocialComment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([postType])
  @@index([companyId])
}

model SocialComment {
  id            String   @id @default(cuid())
  postId        String
  post          SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        Employee @relation("SocialComment_Author", fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model SocialLike {
  id            String   @id @default(cuid())
  postId        String
  userId        String   // Employee ID
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ─── Kanban Board ──────────────────────────────────────────
model KanbanBoard {
  id            String   @id @default(cuid())
  name          String
  description   String?
  companyId     String?
  createdById   String
  creator       Employee @relation("KanbanBoard_Creator", fields: [createdById], references: [id], onDelete: Cascade)
  columns       String   @default("Backlog,To Do,In Progress,Done") // Comma-separated column names
  isActive      Boolean  @default(true)
  cards         KanbanCard[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
}

model KanbanCard {
  id            String   @id @default(cuid())
  boardId       String
  board         KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  column        String   // Column name: "Backlog" | "To Do" | "In Progress" | "Done"
  priority      String   @default("Medium") // High | Medium | Low
  category      String?  // HR | Recruitment | Onboarding | Training | Payroll | Compliance | Benefits | Performance | IT | General
  assignedToId  String?
  assignee      Employee? @relation("KanbanCard_Assignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  subtasks      String?  // JSON array of { title, completed: bool }
  tags          String?  // JSON array
  order         Int      @default(0) // For sorting within column
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([boardId])
  @@index([column])
  @@index([assignedToId])
}

// ─── Collaboration Settings (persisted per-tenant) ─────────
model CollaborationSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  encryptionEnabled       Boolean  @default(true)
  fileSharingLimitMB      Int      @default(25)
  messageRetentionDays    Int      @default(90)
  calendarSyncEnabled     Boolean  @default(true)
  calendarSyncProvider    String   @default("google") // google | outlook | ical
  emailIntegrationEnabled Boolean  @default(false)
  emailProvider           String   @default("smtp") // smtp | google | outlook | resend
  // ─── SMTP Configuration ───
  smtpHost                String?  // e.g. smtp.gmail.com, smtp.office365.com
  smtpPort                Int      @default(587)
  smtpUsername            String?  // SMTP login / email address
  smtpPassword            String?  // Encrypted SMTP password / app password
  smtpEncryption          String   @default("tls") // tls | ssl | none
  smtpFromName            String?  // Display name for outgoing emails
  smtpFromAddress         String?  // From address override (if different from username)
  smtpReplyTo             String?  // Reply-to address
  smtpVerifiedAt          DateTime? // When SMTP creds were last verified
  smtpVerifyError         String?  // Last verification error message
  // ─── Resend Configuration (alternative to SMTP) ───
  resendApiKey            String?  // Resend API key (if emailProvider = 'resend')
  resendFromAddress       String?  // Verified sender address for Resend
  autoDeleteMessages      Boolean  @default(false)
  maxCallDurationMin      Int      @default(60)
  allowExternalSharing    Boolean  @default(true)
  watermarkEnabled        Boolean  @default(false)
  updatedBy               String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}
