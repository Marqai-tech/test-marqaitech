// ============ P0 FIX: MISSING MODELS (added 2026-06-20) ============
//
// These models were referenced by API routes but never declared in the schema,
// causing runtime crashes (prisma.<model> is not a function). Adding them
// unblocks: preboarding, exit-workflow, okrs, exit-interview, engagement,
// and ai-admin routes.
//
// All are appended at the end of the schema and use only ADDITIVE DDL in
// schema-sync.{js,ts} so they don't affect existing models.

// ─── Preboarding Candidate (REQ-ONB-02 pre-onboarding pipeline) ───
// Used by /api/preboarding/** — tracks candidates between offer acceptance
// and Day-1 joining (document collection, BGV, IT provisioning, etc.).
model PreboardingCandidate {
  id              String   @id @default(cuid())
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  jobTitle        String?
  departmentId    String?
  offeredSalary   Float?
  currency        String   @default("INR")
  offerDate       DateTime @default(now())
  joiningDate     DateTime?
  notes           String?

  // Offer link (raw string — not a FK to Offer, to keep the model self-contained)
  offerId         String?

  // Status state machine:
  // offer_accepted → document_collection → bgv → provisioning → asset_request → joined → cancelled
  status          String   @default("offer_accepted")

  // Document collection (JSON map of docType → fileUrl)
  documentsUploaded String?

  // Background verification
  backgroundCheckStatus  String  @default("pending") // pending, in_progress, cleared, failed
  backgroundCheckNotes   String?

  // HR + IT gate flags
  hrVerified         Boolean @default(false)
  accountProvisioned Boolean @default(false)

  // ─── REQ-ONB-01/05/08: Cascade wiring ───
  // Populated when preboarding completes — points to the newly created Employee record.
  employeeId         String?
  // Requisition that this hire fulfills (optional — for analytics).
  requisitionId      String?
  // IT provisioning tracking
  itProvisioningStatus String @default("pending") // pending | initiated | completed | failed
  itProvisioningNotes  String?
  // Buddy assigned for Day-1 (Employee.id)
  buddyEmployeeId    String?
  // Welcome series tracking
  welcomeSeriesInitiated Boolean @default(false)

  // Background checks (REQ-ONB-03)
  backgroundChecks   BackgroundCheck[]
  // Welcome series emails (REQ-ONB-04)
  welcomeSeriesEmails WelcomeSeriesEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([candidateEmail])
  @@index([employeeId])
}

// ─── Exit Request (REQ-EXIT-01 employee self-service resignation) ───
// Used by /api/exit-workflow/** — alternative to /api/separation for the
// employee-initiated resignation flow. Kept separate from Separation so
// existing admin-facing separation logic is undisturbed.
model ExitRequest {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type            String   @default("resignation") // resignation, termination, retirement, layoff
  reason          String?
  noticePeriodEndDate DateTime?
  lastWorkingDate DateTime?

  // pending → in_progress → completed | cancelled | withdrawn
  status          String   @default("pending")

  // Snapshot of clearance state (free-text until clearance-task model is added)
  clearanceNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
}

// ─── OKR + KeyResult (REQ-PER-01 cascade) ───
// Used by /api/okrs/** — supports Company → Sub-Company → Project → Individual
// cascade via parentOkrId self-reference and category field.
model OKR {
  id          String   @id @default(cuid())
  objective   String

  // Owner: an Employee (individual OKR) — for company/group/project OKRs,
  // ownerId can store the company/project ID and category will distinguish.
  // Made nullable for company-level OKRs (REQ-PER-01 cascade).
  ownerId     String?
  owner       Employee?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Cascade ownership — for category='company' or 'sub_company', companyId is set.
  // For category='project', projectId is set. For category='individual', ownerId is set.
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Audit: who created this OKR
  createdById String?

  quarter     String   @default("Q1 2026")
  year        Int      @default(2026)

  // Cascade level: 'company' | 'sub_company' | 'project' | 'individual'
  category    String   @default("individual")

  // Self-reference for parent-child cascade
  parentOkrId String?
  parentOkr   OKR?     @relation("OkrCascade", fields: [parentOkrId], references: [id], onDelete: SetNull)
  childOkrs   OKR[]    @relation("OkrCascade")

  // Status: draft | active | at_risk | completed | missed
  status      String   @default("draft")

  keyResults  KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([projectId])
  @@index([parentOkrId])
  @@index([category])
  @@index([quarter])
  @@index([year])
}

model KeyResult {
  id           String  @id @default(cuid())
  okrId        String
  okr          OKR     @relation(fields: [okrId], references: [id], onDelete: Cascade)

  title        String
  targetValue  Float   @default(100)
  currentValue Float   @default(0)
  unit         String? // '%', 'count', 'USD', etc.

  // Status: not_started | in_progress | completed | missed
  status       String  @default("not_started")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([okrId])
}

// ─── Exit Interview (REQ-EXIT-05 digital exit interview forms) ───
// Used by /api/exit-interview/** — structured interview record linked to
// Separation + Employee. The existing Separation.exitInterview free-text
// field is kept for backwards compatibility.
model ExitInterview {
  id             String   @id @default(cuid())
  separationId   String
  separation     Separation @relation(fields: [separationId], references: [id], onDelete: Cascade)

  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  interviewDate  DateTime @default(now())
  interviewer    String?
  reason         String?
  feedback       String?
  rating         Int?     // 1-5
  wouldRehire    Boolean?
  suggestions    String?

  // Multi-lingual: language code (e.g. 'en', 'es', 'fr') — defaults to tenant language
  language       String   @default("en")

  // AI sentiment analysis (REQ-EXIT-06) — populated by /api/exit-interview POST
  sentimentScore Float?
  sentimentLabel String?  // positive | neutral | negative
  sentimentSummary String?

  status         String   @default("completed") // draft, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([separationId])
  @@index([employeeId])
}

// ─── Engagement: Survey + SurveyResponse + Recognition ───
// Used by /api/engagement/** — replaces the missing engagement models.
model Survey {
  id              String   @id @default(cuid())
  title           String
  description     String?
  type            String   @default("pulse") // pulse, annual, onboarding, exit
  status          String   @default("draft") // draft, active, closed
  anonymous       Boolean  @default(true)
  targetAudience  String   @default("all") // all, department, company, role
  questions       String   // JSON array of question objects
  startDate       DateTime @default(now())
  endDate         DateTime?

  responses       SurveyResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  answers     String   // JSON array of {questionId, value}
  sentiment   String?  // positive | neutral | negative (AI-computed)

  createdAt DateTime @default(now())

  @@index([surveyId])
  @@index([employeeId])
}

model Recognition {
  id          String   @id @default(cuid())
  // fromId is a User.id (the recognizer), toId is an Employee.id (the recipient)
  fromId      String
  toId        String
  toEmployee  Employee @relation(fields: [toId], references: [id], onDelete: Cascade)

  type        String   @default("kudos") // kudos, shoutout, award, milestone
  title       String   @default("")
  message     String
  points      Int      @default(0)
  isPublic    Boolean  @default(true)
  category    String   @default("general") // general, performance, culture, leadership

  createdAt DateTime @default(now())

  @@index([toId])
  @@index([category])
}

// ─── AI Admin Console: AIConfig + AIPromptLog ───
// Used by /api/ai-admin/** — configures prompts/models and logs every AI call
// for observability, bias auditing, and cost tracking.
model AIConfig {
  id          String   @id @default(cuid())
  name        String
  type        String   // prompt_template, model_config, system_prompt
  category    String   // recruitment, performance, training, interview, chatbot
  content     String   // the prompt body / config JSON
  model       String   @default("gpt-4") // gpt-4, glm-4, claude-3, etc.
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2048)
  isActive    Boolean  @default(true)
  version     String   @default("1.0")
  description String?

  // Bias / safety guardrails (JSON)
  biasChecks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isActive])
}

model AIPromptLog {
  id           String   @id @default(cuid())
  category     String   // recruitment, performance, training, interview, chatbot
  status       String   @default("success") // success, error, timeout
  model        String?
  promptInput  String?  // truncated prompt for audit
  promptOutput String?  // truncated output for audit
  latencyMs    Int      @default(0)
  tokensUsed   Int      @default(0)
  errorMessage String?

  // Bias audit fields
  biasFlag     Boolean  @default(false)
  biasReason   String?

  userId       String?
  configId     String?

  createdAt DateTime @default(now())

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// ============ DOCUMENTATION HUB ============

model DocCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  icon        String @default("FiBookOpen")
  color       String @default("blue")
  sortOrder   Int    @default(0)
  status      String @default("active") // active, archived

  articles    DocArticle[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocArticle {
  id          String @id @default(cuid())
  categoryId  String
  category    DocCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  title       String
  slug        String @unique
  summary     String?
  content     String // Markdown content
  docType     String @default("functional") // technical, functional, workflow, security, ai, sop, training
  moduleKey   String? // Links to a specific HRMS module (e.g., "recruitment", "payroll")
  tags        String? // Comma-separated tags
  version     String @default("1.0")
  status      String @default("published") // draft, published, archived
  authorId    String?
  viewCount   Int    @default(0)
  sortOrder   Int    @default(0)

  accessRules DocAccessRule[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([docType])
  @@index([moduleKey])
  @@index([status])
}

model DocAccessRule {
  id         String @id @default(cuid())
  articleId  String
  article    DocArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Access control: either role-based or user-specific
  role       String? // super_admin, tenant_admin, hr_admin, manager, employee (null = all roles)
  userId     String? // Specific user access (null = role-based)

  accessType String @default("read") // read, edit, manage
  grantedBy  String? // userId of super_admin who granted access

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([articleId])
  @@index([role])
  @@index([userId])
}

// ============ AI INTERVIEW PLATFORM ============

model InterviewSet {
  id                      String   @id @default(cuid())
  title                   String
  roleTitle               String
  jobDescription          String?
  tenantId                String
  interviewMode           String   @default("text") // text, voice, video, mcq, coding
  language                String   @default("en")
  timeLimit               Int      @default(30)
  cvProbeDuration         Int      @default(10)
  enablePreScreening      Boolean  @default(true)
  enableProctoring        Boolean  @default(true)
  enableDynamicFollowUp   Boolean  @default(true)
  status                  String   @default("draft") // draft, active, archived
  preScreenFilters        Json?
  evaluationConfig        Json?
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  questions               InterviewSetQuestion[]
  sessions                InterviewSession[]
  invitations             InterviewInvitation[]

  @@index([tenantId])
  @@index([status])
}

model InterviewSetQuestion {
  id              String   @id @default(cuid())
  setId           String
  order           Int
  category        String   // technical, behavioral, situational, cv_based, cognitive
  question        String
  expectedPoints   String?
  followUpPrompts  String?
  duration        Int?
  isMandatory     Boolean  @default(true)
  difficulty      String   @default("medium") // easy, medium, hard
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  set             InterviewSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

model InterviewSession {
  id                  String    @id @default(cuid())
  setId               String
  candidateName       String
  candidateEmail      String
  candidatePhone      String?
  resumeUrl           String?
  resumeParsed        Json?
  language            String    @default("en")
  status              String    @default("invited") // invited, pre_screen, in_progress, completed, expired, disqualified
  preScreenResult     Json?
  startedAt           DateTime?
  completedAt         DateTime?
  videoUrl            String?
  audioUrl            String?
  transcriptUrl       String?
  fullTranscript      String?
  overallScore        Int?
  communicationScore  Int?
  grammarScore        Int?
  fluencyScore        Int?
  comprehensionScore  Int?
  vocabularyScore     Int?
  cognitiveScore      Int?
  skillMatchScore     Int?
  aiSummary           String?
  aiRecommendation    String? // strong_hire, hire, no_hire, not_enough_evidence
  durationSeconds     Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  set                 InterviewSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  responses           InterviewResponse[]
  proctoringLogs      ProctoringLog[]

  @@index([setId])
  @@index([status])
  @@index([candidateEmail])
}

model InterviewResponse {
  id                String   @id @default(cuid())
  sessionId         String
  questionId        String?
  order             Int
  question          String?
  responseText      String?
  responseAudioUrl  String?
  responseVideoUrl  String?
  responseDuration  Int?
  aiScore           Int?
  aiFeedback        String?
  followUpFromId    String?
  isFollowUp        Boolean  @default(false)
  isCvBased         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  followUpFrom      InterviewResponse?  @relation("ResponseFollowUp", fields: [followUpFromId], references: [id], onDelete: SetNull)
  followUps         InterviewResponse[]  @relation("ResponseFollowUp")

  @@index([sessionId])
  @@index([followUpFromId])
}

model ProctoringLog {
  id            String   @id @default(cuid())
  sessionId     String
  eventType     String   // tab_switch, face_not_detected, multiple_faces, audio_anomaly, copy_paste, ai_assistant_detected, browser_devtools
  severity      String   @default("low") // low, medium, high, critical
  details       String?
  timestamp     DateTime @default(now())
  screenshotUrl String?

  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([severity])
}

model InterviewInvitation {
  id                   String    @id @default(cuid())
  setId                String
  candidateEmail       String
  candidateName        String
  invitationToken      String    @unique
  invitationUrl        String?
  status               String    @default("pending") // pending, sent, opened, started, completed, expired, bounced
  sentAt               DateTime?
  openedAt             DateTime?
  expiresAt            DateTime?
  emailDeliveryStatus  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  set                  InterviewSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([invitationToken])
  @@index([status])
}

// ============ RBAC - ROLE & PERMISSION MANAGEMENT ============

model Role {
  id          String @id @default(cuid())
  name        String
  key         String  // unique key like 'hr_admin', 'manager', custom roles
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted
  level       Int     @default(0) // hierarchy level: 0=super_admin, 1=tenant_admin, etc.

  tenantId    String? // null for global/system roles (super_admin)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId   String? // null for tenant-level roles, set for company-specific roles
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  status      String  @default("active")
  createdBy   String? // userId who created this role

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@index([key])
}

model Module {
  id          String @id @default(cuid())
  key         String @unique // e.g. 'employees', 'recruitment', 'payroll'
  name        String // display name
  description String?
  category    String // group: 'Core HR', 'Talent', 'Operations', etc.
  icon        String? // icon name for UI
  sortOrder   Int    @default(0)

  permissions Permission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String @id @default(cuid())
  moduleId    String
  module      Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  action      String // 'view', 'create', 'edit', 'delete', 'export', 'approve'
  description String?

  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleId, action])
  @@index([moduleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  granted      Boolean @default(true) // true=grant, false=deny (for override)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String? // specific company scope

  assignedBy String? // userId who assigned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
}

// ============ ADVANCED PAYROLL MODULE - MULTI-CURRENCY, MULTI-COUNTRY, MULTI-DIMENSIONAL ============

// --- CTC Template & Component Mapping ---

model CTCTemplate {
  id               String   @id @default(cuid())
  name             String
  countryCode      String   @default("IND") // ISO 3166-1 alpha-3
  legalEntityId    String?  // NULL = applicable to all entities in country
  currencyCode     String   @default("INR") // ISO 4217
  ctcType          String   @default("ANNUAL") // ANNUAL, MONTHLY
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  version          Int      @default(1)
  status           String   @default("DRAFT") // DRAFT, ACTIVE, INACTIVE
  isDefault        Boolean  @default(false)
  basePayPct       Float?   // Default % of CTC allocated to base pay
  createdBy        String?
  companyId        String?  // Link to company for multi-tenant scope

  componentMappings CTCComponentMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([status])
  @@index([companyId])
}

model CTCComponentMapping {
  id                 String   @id @default(cuid())
  ctcTemplateId      String
  ctcTemplate        CTCTemplate @relation(fields: [ctcTemplateId], references: [id], onDelete: Cascade)
  componentId        String?  // FK to PayrollComponent
  componentName      String
  componentCategory  String   @default("EARNING") // EARNING, DEDUCTION, EMPLOYER_CONTRIBUTION, REIMBURSEMENT, BENEFIT_IN_KIND
  allocationMethod   String   @default("PERCENTAGE_OF_CTC") // PERCENTAGE_OF_CTC, FIXED_AMOUNT, PERCENTAGE_OF_COMPONENT, FORMULA, PRORATA
  allocationValue    Float    @default(0)
  baseComponentId    String?  // Reference component when allocationMethod = PERCENTAGE_OF_COMPONENT
  formulaExpression  String?  // Formula when allocationMethod = FORMULA
  calculationSequence Int     @default(1)
  isStatutory        Boolean  @default(false)
  isTaxable          Boolean  @default(true)
  taxExemptionLimit  Float?
  frequency          String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, ONCE, VARIABLE
  prorationRule      String?  // CALENDAR_DAYS, WORKING_DAYS, FIXED_MONTH
  minAmount          Float?
  maxAmount          Float?
  roundingRule       String?  // NEAREST, UP, DOWN, NEAREST_10, NEAREST_100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ctcTemplateId])
  @@index([calculationSequence])
}

// --- Payroll Component Master ---

model PayrollComponent {
  id                  String   @id @default(cuid())
  code                String   // Short code: BASIC, HRA, EPF_EE, PIT
  name                String
  componentType       String   // EARNING, DEDUCTION, EMPLOYER_CONTRIB, EMPLOYEE_CONTRIB, REIMBURSEMENT, BENEFIT_IN_KIND, INFORMATIONAL
  componentCategory   String   // NORMAL, STATUTORY
  countryCode         String   @default("IND")
  calculationType     String   // FLAT_AMOUNT, PERCENTAGE, SLAB_BASED, FORMULA, LOOKUP_TABLE, MANUAL_ENTRY
  defaultValue        Float?   // Default flat amount or percentage
  percentageBase      String?  // Component code of base for percentage calc
  formulaId           String?  // Reference to formula definition
  slabTableId         String?  // Reference to slab/rate table
  isTaxable           Boolean  @default(true)
  taxTreatment        String?  // FULLY_TAXABLE, PARTIALLY_TAXABLE, EXEMPT, DEFERRED
  exemptionSection    String?  // e.g. "80C", "80D", "401k"
  maxExemptionAmt     Float?
  affectsGross        Boolean  @default(true)
  affectsNet          Boolean  @default(true)
  affectsCTC          Boolean  @default(true)
  paymentFrequency    String   @default("MONTHLY") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL, ONE_TIME, VARIABLE
  prorationApplicable Boolean  @default(true)
  roundingRule        String?  // NEAREST, CEILING, FLOOR, NEAREST_10, NEAREST_100, BANKERS_ROUNDING
  isActive            Boolean  @default(true)
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  companyId           String?

  statutoryDetails    StatutoryComponent[]
  slabLines           TaxSlabRateLine[]
  glMappings          GLAccountMapping[]
  transactionLines    PayrollTransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, countryCode])
  @@index([countryCode])
  @@index([componentCategory])
  @@index([componentType])
  @@index([companyId])
}

// --- Statutory Components ---

model StatutoryComponent {
  id                  String   @id @default(cuid())
  componentId         String
  component           PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentCode       String
  componentName       String
  countryCode         String
  authorityName       String
  authorityCode       String?
  partyType           String   // EMPLOYEE, EMPLOYER, BOTH
  calculationBasis    String   // GROSS_PAY, BASIC_PAY, SPECIFIC_COMPONENT, SLAB_BASED, FLAT_RATE
  basisComponentId    String?  // Component ID when calculationBasis = SPECIFIC_COMPONENT
  ratePercentage      Float?   // Contribution rate %
  wageCeiling         Float?   // Maximum basis pay subject to contribution
  maxContributionAmt  Float?
  minContributionAmt  Float?
  slabTableId         String?
  remittanceFrequency String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, ON_DEMAND
  remittanceDueDay    Int?     // Day of month for remittance
  filingFrequency     String?  // MONTHLY, QUARTERLY, ANNUAL, HALF_YEARLY
  filingFormat        String?  // ECR, FPS, W-2, IR8A
  penaltyRatePct      Float?   // Penalty interest rate % per month
  isChallanRequired   Boolean  @default(false)
  challanFormat       String?
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([componentId])
  @@index([countryCode])
}

// --- Income Tax Slab Configuration ---

model TaxSlabTable {
  id              String   @id @default(cuid())
  name            String
  countryCode     String
  taxYear         String
  filingStatus    String?  // SINGLE, MARRIED_JOINT, MARRIED_SEPARATE, HEAD_OF_HOUSEHOLD, SENIOR_CITIZEN
  regimeType      String?  // OLD, NEW, STANDARD
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  companyId       String?

  rateLines       TaxSlabRateLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([taxYear])
}

model TaxSlabRateLine {
  id              String   @id @default(cuid())
  slabTableId     String
  slabTable       TaxSlabTable @relation(fields: [slabTableId], references: [id], onDelete: Cascade)
  sequence        Int
  incomeFrom      Float    @default(0)
  incomeTo        Float?   // NULL = no upper limit
  ratePercentage  Float    @default(0)
  fixedAmount     Float?   // Fixed tax for cumulative calc
  surchargeRate   Float?
  cessRate        Float?   // Health/Education cess %

  component       PayrollComponent? @relation(fields: [componentId], references: [id])
  componentId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slabTableId])
  @@index([sequence])
}

// --- Payroll Input Management ---

model PayrollInput {
  id                String   @id @default(cuid())
  payrollRunId      String?  // FK to PayrollRun
  payrollRun        PayrollRun? @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  inputType         String   // ATTENDANCE, LEAVE, OVERTIME, VARIABLE_PAY, ONE_TIME, REIMBURSEMENT, LOAN, INVESTMENT, TAX_ADJ, ORG_CHANGE
  componentCode     String
  inputValueNumeric Float?
  unitType          String?  // AMOUNT, DAYS, HOURS, PERCENTAGE
  inputDateFrom     DateTime?
  inputDateTo       DateTime?
  currencyCode      String?  @default("INR")
  exchangeRate      Float?
  approvalStatus    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy        String?
  approvalDate      DateTime?
  source            String   @default("MANUAL") // MANUAL, BULK_UPLOAD, API_INTEGRATION, SELF_SERVICE, SYSTEM_GENERATED
  referenceDocument String?
  remarks           String?
  createdBy         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([payrollRunId])
  @@index([inputType])
  @@index([approvalStatus])
}

// --- Multi-Currency Processing ---

model CurrencyConfig {
  id                  String   @id @default(cuid())
  legalEntityId       String
  baseCurrency        String   @default("INR")
  payrollCurrency     String   @default("INR")
  reportingCurrency   String?
  exchangeRateSource  String   @default("MANUAL") // CENTRAL_BANK, REUTERS, BLOOMBERG, MANUAL, CUSTOM_API
  rateType            String   @default("SPOT") // SPOT, MONTHLY_AVERAGE, CUSTOM, CONTRACTUAL
  autoFetchEnabled    Boolean  @default(false)
  fetchFrequency      String?  // DAILY, WEEKLY, MONTHLY, ON_DEMAND
  roundingPrecision   Int      @default(2)
  roundingRule        String   @default("NEAREST") // NEAREST, UP, DOWN, BANKERS
  gainLossAccount     String?  // GL account for exchange rate gains/losses
  companyId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalEntityId])
  @@index([companyId])
}

model ExchangeRate {
  id              String   @id @default(cuid())
  fromCurrency    String
  toCurrency      String
  exchangeRate    Float
  rateDate        DateTime
  rateType        String   @default("SPOT") // SPOT, MONTHLY_AVERAGE, QUARTERLY_AVERAGE, CUSTOM, CONTRACTUAL
  source          String   @default("Manual Entry")
  inverseRate     Float?
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromCurrency, toCurrency, rateDate])
  @@index([isActive])
}

// --- Multi-Dimensional Allocation ---

model DimensionDefinition {
  id                String   @id @default(cuid())
  code              String   // DEPT, CC, PROJ, LOC, BU
  name              String
  dimensionType     String   @default("STANDARD") // STANDARD, CUSTOM
  hierarchyEnabled  Boolean  @default(false)
  allocationMethod  String   @default("PERCENTAGE") // PERCENTAGE, AMOUNT, HEADCOUNT, FTE
  isMandatory       Boolean  @default(false)
  allowMultiple     Boolean  @default(true)
  maxAllocations    Int?
  effectiveFrom     DateTime @default(now())
  companyId         String?

  allocations       EmployeeDimensionAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([companyId])
}

model EmployeeDimensionAllocation {
  id               String   @id @default(cuid())
  employeeId       String
  dimensionId      String
  dimension        DimensionDefinition @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  dimensionValueId String   // e.g. Department = "Engineering", CC = "CC-1001"
  allocationPct    Float    @default(100)
  allocationAmount Float?
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  isPrimary        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([dimensionId])
}

// --- Payroll Run (Processing Workflow) ---

model PayrollRun {
  id                  String   @id @default(cuid())
  legalEntityId       String
  payrollPeriod       String   // e.g. "2026-06"
  periodStartDate     DateTime
  periodEndDate       DateTime
  payDate             DateTime
  runType             String   @default("REGULAR") // REGULAR, OFF_CYCLE, SUPPLEMENTAL, FINAL_SETTLEMENT, CORRECTION
  runStatus           String   @default("OPEN") // OPEN, INPUT_COLLECTION, PROCESSING, REVIEW, APPROVED, ACCOUNTING, DISBURSED, CLOSED
  currencyCode        String   @default("INR")
  exchangeRateDate    DateTime?
  taxProjectionMethod String   @default("CUMULATIVE") // CUMULATIVE, NON_CUMULATIVE, ANNUALIZED
  includeStatutory    Boolean  @default(true)
  processingMode      String   @default("FULL") // FULL, DELTA
  initiatedBy         String?
  companyId           String?
  totalEmployees      Int      @default(0)
  totalGrossPay       Float    @default(0)
  totalDeductions     Float    @default(0)
  totalNetPay         Float    @default(0)
  totalEmployerContrib Float   @default(0)

  // Lock / approval / audit trail (REQ-PAY-07, REQ-7.2, REQ-SEC-PAY-02/03, REQ-AI-PAY-01/03)
  lockRequests         PayrollLockRequest[]
  approvals            PayrollApproval[]
  anomalies            PayrollAnomaly[]
  ghostEmployeeFlags   GhostEmployeeFlag[]
  company              Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  transactionLines    PayrollTransactionLine[]
  payrollInputs       PayrollInput[]
  complianceFilings   ComplianceFiling[]
  bankPaymentFiles    BankPaymentFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([legalEntityId, payrollPeriod, runType])
  @@index([runStatus])
  @@index([companyId])
  @@index([payrollPeriod])
}

// --- Payroll Transaction Line ---

model PayrollTransactionLine {
  id                    String   @id @default(cuid())
  payrollRunId          String
  payrollRun            PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId           String?
  component             PayrollComponent? @relation(fields: [componentId], references: [id])
  componentCode         String
  componentType         String   // EARNING, DEDUCTION, EMPLOYER_CONTRIB, EMPLOYEE_CONTRIB, REIMBURSEMENT, INFO
  componentCategory     String   // NORMAL, STATUTORY
  calculatedAmount      Float    @default(0)
  overrideAmount        Float?
  finalAmount           Float    @default(0)
  currencyCode          String   @default("INR")
  exchangeRate          Float?
  baseCurrencyAmount    Float?
  ytdAmount             Float    @default(0)
  mtdAmount             Float    @default(0)
  prorationFactor       Float?   // 1.0 = full period
  inputSourceId         String?
  formulaTrace          String?  // JSON trace for audit
  dimensionSplitJson    String?  // JSON: {"DEPT": {"ENG": 0.6, "SALES": 0.4}}
  glAccountCode         String?
  costCenterCode        String?
  isReversal            Boolean  @default(false)
  reversedTransactionId String?
  taxTreatment          String?  // FULLY_TAXABLE, PARTIALLY_TAXABLE, EXEMPT, PRE_TAX, POST_TAX
  statutoryReference    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([componentCode])
  @@index([componentType])
}

// --- Compliance Management ---

model ComplianceObligation {
  id                  String   @id @default(cuid())
  name                String
  countryCode         String
  authorityName       String
  filingType          String   // RETURN, CHALLAN, CERTIFICATE, REGISTRATION, REPORT, DECLARATION
  frequency           String   // MONTHLY, QUARTERLY, HALF_YEARLY, ANNUAL, ONE_TIME
  dueDateRule         String   // e.g. "D+15" = 15th of following month
  graceDays           Int?
  penaltyType         String?  // FIXED_AMOUNT, PERCENTAGE_PER_DAY, PERCENTAGE_PER_MONTH, PROGRESSIVE
  penaltyValue        Float?
  responsibleRole     String   @default("PAYROLL_ADMIN")
  escalationRole      String?
  reminderDaysBefore  String?  // Comma-separated: "7,3,1"
  autoGenerate        Boolean  @default(false)
  filingFormat        String?
  isActive            Boolean  @default(true)
  companyId           String?

  filings             ComplianceFiling[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([isActive])
  @@index([companyId])
}

model ComplianceFiling {
  id                  String   @id @default(cuid())
  complianceId        String
  compliance          ComplianceObligation @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  payrollRunId        String?
  payrollRun          PayrollRun? @relation(fields: [payrollRunId], references: [id])
  filingPeriod        String
  filingStatus        String   @default("GENERATED") // GENERATED, UNDER_REVIEW, SUBMITTED, ACKNOWLEDGED, REJECTED, PENALTY_APPLIED
  generatedDate       DateTime @default(now())
  submittedDate       DateTime?
  acknowledgementRef  String?
  filingAmount        Float?
  penaltyAmount       Float?
  filePath            String?
  submittedBy         String?
  reviewedBy          String?
  rejectionReason     String?
  resubmissionDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceId])
  @@index([filingStatus])
  @@index([filingPeriod])
}

// --- GL Account Mapping ---

model GLAccountMapping {
  id                  String   @id @default(cuid())
  legalEntityId       String
  componentId         String
  component           PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  debitAccount        String
  creditAccount       String
  costCenterSource    String   @default("EMPLOYEE_DEFAULT") // EMPLOYEE_DEFAULT, COMPONENT_SPECIFIC, DIMENSION_SPLIT
  specificCostCenter  String?
  postingType         String   @default("ACTUAL") // ACCRUAL, ACTUAL, BOTH
  intercompanyAccount String?
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  companyId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalEntityId])
  @@index([componentId])
  @@index([companyId])
}

// ============ INDIAN PAYROLL - ADDITIONAL MODELS ============

// Payroll Definition - Pay frequency, cut-off dates, payment methods at payroll level
model PayrollDefinition {
  id                String   @id @default(cuid())
  name              String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payFrequency      String   @default("MONTHLY") // DAILY, WEEKLY, BI_WEEKLY, SEMI_MONTHLY, MONTHLY, QUARTERLY, SEMI_ANNUALLY, ANNUALLY
  processingCutOff  Int      @default(25) // Day of month for processing cut-off
  paymentDay        Int      @default(1) // Day of month for payment
  currencyCode      String   @default("INR")
  countryCode       String   @default("IN")

  // Allowed payment methods for this payroll
  allowDirectDeposit Boolean  @default(true)
  allowCheque        Boolean  @default(false)
  allowCash          Boolean  @default(false)

  // Costing segments
  costingSegments    String?  // JSON: e.g. ["department","cost_center","location"]

  status             String   @default("active") // active, inactive
  effectiveFrom      DateTime @default(now())
  effectiveTo        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// Employee Payment Method - Bank details with split payment support
model EmployeePaymentMethod {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  paymentType       String   @default("DIRECT_DEPOSIT") // DIRECT_DEPOSIT, CHEQUE, CASH
  bankName          String?
  bankAccountNo     String?
  bankIfscCode      String?
  bankBranch        String?
  accountType       String?  // SAVINGS, CURRENT, SALARY
  currencyCode      String   @default("INR")

  // Split payment support (multiple accounts)
  splitType         String?  // PERCENTAGE, FIXED_AMOUNT
  splitValue        Float?   // Percentage or fixed amount for this method
  isPrimary         Boolean  @default(true)
  priority          Int      @default(1)

  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  status            String   @default("active") // active, inactive

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// Loan Management - Full loan lifecycle
model Loan {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  loanType          String   // PERSONAL, EMERGENCY, HOUSING, VEHICLE, EDUCATION, FESTIVAL, OTHER
  loanAmount        Float
  interestRate      Float    @default(0)
  tenureMonths      Int
  emiAmount         Float
  outstandingBalance Float
  disbursedAmount   Float
  disbursedDate     DateTime?
  startDate         DateTime
  endDate           DateTime?
  recoveredAmount   Float    @default(0)
  remainingEmis     Int

  status            String   @default("pending") // pending, approved, active, completed, cancelled, defaulted
  approvedBy        String?
  approvedAt        DateTime?

  // Recovery tracking
  recoverySchedule  String?  // JSON: array of {month, year, amount, status}

  remarks           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([loanType])
}

// Overtime Management
model OvertimeRecord {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date              DateTime
  hours             Float    @default(0)
  rateType          String   @default("FLAT") // FLAT, PERCENTAGE_OF_BASIC, HOURLY_RATE
  rate              Float    @default(0)
  amount            Float    @default(0)

  reason            String?
  project           String?
  approvedBy        String?
  approvedAt        DateTime?
  status            String   @default("pending") // pending, approved, rejected, processed

  payrollRunId      String?  // Linked to payroll run when processed

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([status])
  @@index([date])
}

// Payroll Hold - Hold/suspend employee payroll
model PayrollHold {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  holdType          String   // FULL_HOLD, PARTIAL_HOLD, DEDUCTION_ONLY
  reason            String
  holdFromPeriod    String   // e.g. "2026-06"
  holdToPeriod      String?  // NULL = indefinite
  heldComponents    String?  // JSON array of component codes to hold (for partial hold)

  releasedDate      DateTime?
  releasedBy        String?
  status            String   @default("active") // active, released, cancelled

  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// Bank Payment File - Generated bank files for salary disbursement
model BankPaymentFile {
  id                String   @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  fileName          String
  fileFormat        String   @default("NACH") // NACH, NEFT, RTGS, CUSTOM
  bankCode          String?
  totalAmount       Float    @default(0)
  totalRecords      Int      @default(0)
  fileContent       String?  // Base64 encoded or JSON

  generatedBy       String?
  generatedAt       DateTime @default(now())
  status            String   @default("generated") // generated, submitted, acknowledged, rejected

  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([payrollRunId])
  @@index([status])
  @@index([companyId])
}

// Pre-Payroll Validation Result
model PayrollValidation {
  id                String   @id @default(cuid())
  payrollRunId      String?
  companyId         String?

  validationType    String   // PRE_PAYROLL, POST_PAYROLL
  status            String   @default("pending") // pending, completed, failed

  // Validation results as JSON
  missingPaymentMethods  String?  // JSON array of employee IDs
  missingSalaryBasis     String?  // JSON array of employee IDs
  heldEmployees          String?  // JSON array of employee IDs
  newJoiners             String?  // JSON array of employee IDs
  terminations           String?  // JSON array of employee IDs
  errors                 String?  // JSON array of error objects
  warnings               String?  // JSON array of warning objects

  totalEmployees     Int      @default(0)
  validEmployees     Int      @default(0)
  invalidEmployees   Int      @default(0)

  runBy              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([payrollRunId])
  @@index([companyId])
}

// ============ INCOME TAX DECLARATION ============

model IncomeTaxDeclaration {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  financialYear     String   // e.g. "2024-25"
  regimeType        String   @default("NEW") // OLD, NEW

  // Section 80C
  section80C_PPF            Float @default(0)
  section80C_ELSS           Float @default(0)
  section80C_LIC            Float @default(0)
  section80C_HomeLoanPrincipal Float @default(0)
  section80C_Other          Float @default(0)
  section80C_Total          Float @default(0)

  // Section 80D
  section80D_Self           Float @default(0)
  section80D_Parents        Float @default(0)
  section80D_Total          Float @default(0)

  // Section 80CCD
  section80CCD_NPS          Float @default(0)

  // Section 24(b)
  section24b_HomeLoanInterest Float @default(0)

  // HRA
  hra_ActualHRA             Float @default(0)
  hra_RentPaid              Float @default(0)
  hra_IsMetro               Boolean @default(false)
  hra_ExemptionCalc         Float @default(0)

  // Other
  section80E_EducationLoan  Float @default(0)
  section80G_Donations      Float @default(0)
  section80TTA_SavingsInterest Float @default(0)
  otherDeductions           Float @default(0)

  // Computed
  totalDeductions           Float @default(0)
  taxableIncome             Float @default(0)
  estimatedTax              Float @default(0)

  // Status
  status                    String @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  submittedAt               DateTime?
  reviewedBy                String?
  reviewedAt                DateTime?
  reviewComments            String?

  createdBy                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([financialYear])
  @@index([status])
}

// ============ INVOICING (REQ-PM-09) ============
// Multi-currency client invoicing. Header lives in `Invoice`; individual
// billable rows (one per approved timesheet day, milestone, or manual line)
// live in `InvoiceLineItem`. Line-level FX rate can override the invoice-
// level rate for mixed-source invoices.

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Type & billing model
  invoiceType     String   @default("timesheet") // timesheet, milestone, fixed, retainer, expense, manual
  billingType     String   @default("time_and_material") // mirrors Project.billingType

  // Currency — invoice currency is what the client pays in; base currency
  // is the company's reporting currency (for FX gain/loss + profitability).
  currency        String   @default("USD")
  baseCurrency    String?

  // FX — exchange rate is recorded at invoice creation time so the totals
  // never drift even if the rate table is updated later.
  // Semantics: 1 baseCurrency = exchangeRate * currency
  // e.g. baseCurrency=INR, currency=USD, exchangeRate=0.012 → 100 INR = 1.20 USD
  exchangeRate    Float    @default(1)
  fxRateDate      DateTime?
  fxSource        String?  // MANUAL, EXCHANGE_RATE_TABLE, CENTRAL_BANK, INVERSE

  // Totals in invoice currency
  subtotal        Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountRate    Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float    @default(0)

  // Totals in base currency (for reporting / profitability)
  subtotalBase    Float?
  totalAmountBase Float?
  fxGainLoss      Float?

  // Dates
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?

  // Status workflow: draft → issued → sent → (partial|paid|overdue|disputed) → cancelled
  status          String   @default("draft")

  notes           String?
  internalNotes   String?

  // Audit
  createdBy       String?
  issuedBy        String?
  issuedAt        DateTime?
  paidAt          DateTime?
  paymentRef      String?

  lineItems       InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceLineItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Source linkage
  sourceType      String   @default("timesheet") // timesheet, milestone, manual, expense
  timesheetId     String?
  milestoneId     String?
  projectId       String?
  projectTaskId   String?
  employeeId      String?

  description     String
  date            DateTime?

  // Quantity & rate (rate is in INVOICE currency)
  hours           Float    @default(0)
  quantity        Float    @default(1)
  unit            String   @default("hours") // hours, days, units, fixed

  rate            Float    @default(0)
  // Source-rate tracking — original rate in source currency before FX
  rateSourceCurrency String?
  rateSourceAmount   Float?
  fxRate          Float?

  amount          Float    @default(0) // in invoice currency
  amountBase      Float?   // in base currency

  taxable         Boolean  @default(true)
  taxRate         Float?
  taxAmount       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([timesheetId])
  @@index([projectId])
  @@index([employeeId])
}

// ============ GLOBAL PAYROLL ADDENDUM (REQ-PAY-07, REQ-7.2, REQ-AI-PAY-01/02/03, REQ-SEC-PAY-02/03/04, REQ-PAY-19/25) ============
//
// These models implement the "Global Integrated Payroll & Statutory Compliance"
// addendum. They layer ON TOP of the existing PayrollComponent / StatutoryComponent
// / PayrollRun / PayrollTransactionLine / ComplianceFiling infrastructure that
// was already in the schema (Sections 4.x above). They add the missing pieces:
//   • Payroll approval workflow + Segregation-of-Duties enforcement
//   • Immutable audit trail for every manual adjustment
//   • Lock period + formal unlock / re-run requests with audit
//   • AI anomaly detection, statutory-change tracking, ghost-employee detection
//   • Group-level consolidated dashboard support
//   • Cross-border secondment tracking
//   • Localized minimum-wage validation rules
//   • Data-residency policy per company (GDPR / data-localization)

// ─── REQ-PAY-07: Payroll lock & formal unlock / re-run requests ───
// Once a cycle is CLOSED, the underlying transaction lines are immutable.
// Any change requires a PayrollLockRequest, which must be approved by a
// Super Admin or Tenant Admin before the cycle is re-opened. The full
// request + approval trail is retained for audit.
model PayrollLockRequest {
  id              String   @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  requestType     String   // UNLOCK_FOR_RERUN, UNLOCK_FOR_ADJUSTMENT, CORRECTION_RERUN
  reasonCategory  String   // DATA_ERROR, SYSTEM_ERROR, STATUTORY_CHANGE, OTHER
  reasonText      String
  requestedBy     String
  requestedAt     DateTime @default(now())
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, CANCELLED
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewComments  String?
  executedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payrollRunId])
  @@index([status])
  @@index([requestedBy])
}

// ─── REQ-7.2 + REQ-SEC-PAY-02: Payroll approval workflow + SoD ───
// Sub-companies run their local payroll (runStatus = REVIEW), but the bank
// disbursement file cannot be released until the Tenant Admin approves.
// The same user who calculated the run cannot approve it — enforced both
// in the API and by the SoD check below.
model PayrollApproval {
  id              String   @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  approvalStage   String   // CALCULATION_REVIEW, DISBURSEMENT_APPROVAL, POST_DISBURSEMENT_AUDIT
  requestedBy     String
  requestedAt     DateTime @default(now())
  approverRole    String   // tenant_admin, super_admin, finance_controller
  approverUserId  String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, WITHDRAWN
  approvedAt      DateTime?
  rejectionReason String?
  approvalNotes   String?

  // SoD proof — captured at approval time so the audit record cannot be
  // invalidated by a later role change on the requesting user.
  sodConflictFlag Boolean  @default(false)
  sodCheckedAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payrollRunId])
  @@index([status])
  @@index([approverRole])
}

// ─── REQ-SEC-PAY-03: Immutable audit trail for manual adjustments ───
// Every manual bonus, tax override, deduction override, etc. writes exactly
// one row here. reasonText is MANDATORY. beforeValue/afterValue let a
// reviewer reconstruct the original state. Rows are never updated or
// deleted (enforced at the API layer — no PATCH/DELETE route is exposed).
model PayrollAdjustmentLog {
  id              String   @id @default(cuid())
  payrollRunId    String?
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  transactionLineId String?
  componentCode   String
  adjustmentType  String   // MANUAL_BONUS, TAX_OVERRIDE, DEDUCTION_OVERRIDE, RATE_OVERRIDE, INPUT_ADJUSTMENT, REVERSAL
  beforeValue     Float?
  afterValue      Float?
  delta           Float?
  currencyCode    String   @default("INR")
  reasonText      String   // MANDATORY — cannot be empty (API-enforced)
  reasonCategory  String   @default("MANUAL") // MANUAL, STATUTORY_CORRECTION, GRIEVANCE, AUDIT_FINDING, COURT_ORDER
  adjustedBy      String
  adjustedAt      DateTime @default(now())
  approvedBy      String?  // If adjustment required approval (e.g. above threshold)
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([componentCode])
  @@index([adjustedBy])
  @@index([adjustedAt])
}

// ─── REQ-AI-PAY-01: AI anomaly detection ───
// Produced by the AI payroll monitor (could be a scheduled job, an
// embedding-based outlier detector, or rule-based heuristics). Each row
// is one detected anomaly for one employee/run. Status workflow lets
// the payroll admin acknowledge / dismiss / investigate each flag.
model PayrollAnomaly {
  id              String   @id @default(cuid())
  payrollRunId    String?
  payrollRun      PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  anomalyType     String   // NET_PAY_SPIKE, OT_SPIKE, GROSS_DROP, TAX_ZERO, DUPLICATE_BANK, COMPONENT_NEW, MIN_WAGE_BREACH
  severity        String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  metricName      String?  // e.g. "net_pay_pct_change"
  observedValue   Float?
  baselineValue   Float?
  deviationPct    Float?
  detectionMethod String   @default("STATISTICAL") // STATISTICAL, ML_MODEL, RULE_BASED, HYBRID
  description     String
  evidenceJson    String?  // supporting data (prior periods, sibling averages, etc.)
  status          String   @default("OPEN") // OPEN, ACKNOWLEDGED, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  reviewedBy      String?
  reviewedAt      DateTime?
  resolutionNotes String?

  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([anomalyType])
  @@index([status])
  @@index([severity])
  @@index([companyId])
}

// ─── REQ-AI-PAY-02: Statutory compliance change tracking ───
// Periodically scraped / ingested from tax authority websites or legal
// feeds. Surfaces upcoming changes to Tenant Admin so they can update
// the rules engine before the effective date.
model ComplianceChangeAlert {
  id              String   @id @default(cuid())
  countryCode     String
  authorityName   String
  changeType      String   // TAX_SLAB_CHANGE, SS_RATE_CHANGE, WAGE_CAP_CHANGE, FILING_FORMAT_CHANGE, NEW_OBLIGATION, MINIMUM_WAGE_CHANGE
  title           String
  description     String
  sourceUrl       String?
  sourceName      String?
  effectiveDate   DateTime
  announcedDate   DateTime @default(now())
  impactLevel     String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  affectedComponents String? // JSON array of PayrollComponent codes
  status          String   @default("NEW") // NEW, ACKNOWLEDGED, IN_REVIEW, APPLIED, IGNORED
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  appliedBy       String?
  appliedAt       DateTime?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([countryCode])
  @@index([effectiveDate])
  @@index([status])
  @@index([impactLevel])
}

// ─── REQ-AI-PAY-03: Ghost employee detection ───
// Cross-references active payroll against Timesheet + active-directory
// activity logs. A flag with zero timesheet hours AND zero IT logins
// during the payroll period is a candidate "ghost employee" (could be
// fraud, or could be a legitimate bench resource — needs human review).
model GhostEmployeeFlag {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId    String?
  payrollRun      PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  payrollPeriod   String   // e.g. "2026-06"
  timesheetHours  Float    @default(0)
  adLoginCount    Int      @default(0)
  emailSentCount  Int      @default(0)
  hasProjectAllocation Boolean @default(false)
  lastActiveDate  DateTime?
  riskScore       Float    @default(0) // 0..100
  riskFactors     String?  // JSON array of factor codes
  status          String   @default("OPEN") // OPEN, INVESTIGATING, CONFIRMED_FRAUD, CONFIRMED_BENCH, FALSE_POSITIVE
  reviewedBy      String?
  reviewedAt      DateTime?
  resolutionNotes String?
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([payrollRunId])
  @@index([status])
  @@index([riskScore])
  @@index([companyId])
}

// ─── REQ-7.2: Cross-border mobility / secondment ───
// Tracks employees seconded to a host country while keeping their home
// country social security active (e.g. via a Certificate of Coverage /
// Totalization Agreement). The payroll engine uses this to decide which
// statutory components apply in the host vs. home country.
model CrossBorderSecondment {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  homeCompanyId   String
  hostCompanyId   String
  homeCountry     String
  hostCountry     String
  startDate       DateTime
  endDate         DateTime?
  certificateRef  String?  // e.g. CoC / A1 certificate number
  taxResidencyStatus String @default("HOME") // HOME, HOST, SPLIT_YEAR, TRC_PENDING
  ssCoverageCountry String @default("HOME") // HOME, HOST, NONE
  homePayPct      Float    @default(100) // % of salary paid via home payroll
  hostPayPct      Float    @default(0)
  homeCurrency    String
  hostCurrency    String
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([homeCompanyId])
  @@index([hostCompanyId])
  @@index([status])
}

// ─── REQ-PAY-19: Minimum wage validation rules ───
// Per-country (and optionally per-state/region) minimum wage config.
// The payroll validation engine compares the calculated gross against
// the configured floor and flags breaches via PayrollAnomaly rows.
model MinimumWageConfig {
  id              String   @id @default(cuid())
  countryCode     String
  regionCode      String?  // e.g. US state code, India state — null = national default
  wageType        String   @default("MONTHLY") // MONTHLY, DAILY, HOURLY
  minimumAmount   Float
  currencyCode    String
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  applicability   String   @default("ALL") // ALL, SKILLED, SEMI_SKILLED, UNSKILLED, APPRENTICE
  sourceName      String?
  sourceUrl       String?
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([countryCode])
  @@index([regionCode])
  @@index([effectiveFrom])
}

// ─── REQ-SEC-PAY-04: Data residency / localization policy ───
// Per-company policy that controls where payroll processing logic is
// permitted to execute. Enforced at the API layer (the payroll run API
// checks the company's residency policy and refuses to execute if the
// request originates from a non-compliant region).
model DataResidencyPolicy {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allowedRegions  String   // JSON array: e.g. ["eu-west-1", "eu-central-1"]
  primaryRegion   String   // Region where the payroll batch MUST execute
  replicationAllowed Boolean @default(false) // If false, data must NOT replicate to other regions
  piiFieldsMasked Boolean  @default(true)
  crossBorderTransferApproved Boolean @default(false)
  legalBasis       String? // e.g. "GDPR Art. 49", "SCCs", "Adequacy decision"
  policyDocumentUrl String?
  reviewedAt       DateTime?
  reviewedBy       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
}

// Add relation back-references onto existing PayrollRun so the new models
// are queryable from the run side as well. (Prisma already supports the
// reverse direction implicitly via the FK columns above; this just makes
// the include() API cleaner.)

// =====================================================================
// EMPLOYEE CORE & COLLABORATION (REQ-EMP-01..06, REQ-SOC-01..05,
// REQ-COL-01..11, REQ-AI-EMP-01..04, REQ-SEC-EMP-01..04)
// Multi-Country · Multi-Tenancy · Multi-Lingual · Multi-Currency · AI-Based
// =====================================================================

// ─── REQ-EMP-02: Localized Custom Fields ──────────────────────────────
// Tenant Admins can configure custom fields that apply only to specific
// countries or sub-companies (Blood Type for Japan, IRP5 for South Africa,
// Visa Expiry for UAE, etc.).
model EmployeeCustomField {
  id            String   @id @default(cuid())
  // Scope: 'global' | 'country' | 'company'
  //   global  → applies to all employees of the tenant
  //   country → applies only to employees in `countryCode`
  //   company → applies only to employees in `companyId`
  scope         String   @default("global")
  countryCode   String?  // ISO 3166-1 alpha-2 (e.g. "JP", "ZA", "AE")
  companyId     String?  // Sub-Company ID

  label         String   // Display label (e.g. "Blood Type")
  key           String   // Stable identifier (e.g. "blood_type")
  fieldType     String   // text | number | date | select | multiselect | boolean | file
  options       String?  // JSON for select/multiselect: ["A","B","O","AB"]
  isRequired    Boolean  @default(false)
  isSystemLocked Boolean @default(false) // REQ-EMP-01: system-locked fields cannot be deleted
  isVisibleToManager Boolean @default(false)
  isVisibleToPeer     Boolean @default(false)
  displayOrder  Int      @default(0)

  // Who configured it (audit)
  createdById   String?

  values        EmployeeCustomFieldValue[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scope, countryCode, companyId])
  @@index([key])
}

// Per-employee values for the custom fields above.
model EmployeeCustomFieldValue {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fieldId       String
  field         EmployeeCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valueText     String?
  valueNumber   Float?
  valueDate     DateTime?
  valueBoolean  Boolean?
  valueJson     String?  // For multiselect / file references

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, fieldId])
  @@index([employeeId])
  @@index([fieldId])
}

// ─── REQ-EMP-04: Dotted-Line Reporting ────────────────────────────────
// Map employees to multiple managers (solid line + dotted lines).
model DottedLineManager {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation("DottedLineManager_Employee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId     String   // The user/employee who is the secondary manager
  manager       Employee @relation("DottedLineManager_Manager", fields: [managerId], references: [id], onDelete: Cascade)
  managerType   String   @default("dotted") // solid | dotted | project | functional
  startDate     DateTime @default(now())
  endDate       DateTime?
  notes         String?  // e.g. "Global Project Lead for Project Alpha"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([managerId])
}

// ─── REQ-EMP-05: Team & Crew Configurations ───────────────────────────
// Virtual teams for collaboration and bulk actions (shift allocations, etc.)
model Team {
  id            String   @id @default(cuid())
  name          String
  description   String?
  teamType      String   @default("virtual") // virtual | crew | shift | project | department
  companyId     String?
  leadId        String?  // Team lead (Employee ID)
  lead          Employee? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  isActive      Boolean  @default(true)
  metadata      String?  // JSON: shift pattern, etc.

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([teamType])
}

model TeamMember {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role          String   @default("member") // lead | member | observer
  joinedAt      DateTime @default(now())
  leftAt        DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

// ─── REQ-SOC-01/02: Social Profile Ingestion ──────────────────────────
model SocialProfile {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider      String   // linkedin | microsoft | google | github | twitter
  providerUserId String?
  profileUrl    String?
  accessToken   String?  // Encrypted at app layer
  refreshToken  String?
  tokenExpiresAt DateTime?
  rawData       String?  // JSON snapshot of imported profile data
  lastSyncedAt  DateTime?
  autoSync      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, provider])
  @@index([employeeId])
}

// ─── REQ-SOC-03/04: SSO & JIT Provisioning ────────────────────────────
model SSOProvider {
  id            String   @id @default(cuid())
  tenantId      String
  name          String   // Display name (e.g. "Corporate Azure AD")
  providerType  String   // saml | oidc | microsoft | google | okta | azuread
  clientId      String?
  clientSecret  String?  // Encrypted
  issuer        String?  // SAML entity ID or OIDC issuer URL
  metadataUrl   String?  // SAML metadata URL or OIDC discovery URL
  redirectUri   String?
  scopes        String?  // JSON array of OIDC scopes
  jitProvisioningEnabled Boolean @default(true) // REQ-SOC-04
  jitDefaultRole String  @default("employee") // Role assigned to JIT-provisioned users
  jitDefaultStatus String @default("pending_onboarding") // REQ-SOC-04
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  logoUrl       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// ─── REQ-SOC-05: Calendar Integration ─────────────────────────────────
model CalendarSync {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider      String   // outlook | google | ical
  calendarId    String?
  refreshToken  String?  // Encrypted
  syncDirection String   @default("bidirectional") // to_calendar | to_hrms | bidirectional
  syncLeaveApproved Boolean @default(true)
  syncHolidays      Boolean @default(true)
  syncFocusTime     Boolean @default(true) // Calendar → HRMS for capacity planning
  lastSyncedAt  DateTime?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, provider])
  @@index([employeeId])
}

// ─── REQ-COL-01/02/03/04: Contextual Chat ─────────────────────────────
model ChatRoom {
  id            String   @id @default(cuid())
  name          String?
  roomType      String   // direct | group | project | team | announcement
  companyId     String?
  projectId     String?
  teamId        String?
  createdBy     String
  avatarUrl     String?
  description   String?
  isE2EE        Boolean  @default(false) // REQ-SEC-EMP-03: End-to-end encryption for 1:1
  isAnnouncement Boolean @default(false) // REQ-6.2: Tenant Admin controls who can create
  retentionDays Int?     // REQ-6.2: Auto-delete messages older than N days
  lastMessageAt DateTime?
  isActive      Boolean  @default(true)

  members       ChatRoomMember[]
  messages      ChatMessage[]
  summaries     ChatSummary[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomType])
  @@index([companyId])
  @@index([projectId])
}

model ChatRoomMember {
  id            String   @id @default(cuid())
  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String
  role          String   @default("member") // admin | member
  joinedAt      DateTime @default(now())
  lastReadAt    DateTime?
  mutedUntil    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId      String
  sender        Employee @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parentMessageId String? // REQ-COL-02: Threading
  parentMessage ChatMessage? @relation("ChatMessage_Thread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       ChatMessage[] @relation("ChatMessage_Thread")
  body          String
  attachments   String?  // JSON array of file metadata
  // REQ-COL-04: AI translation
  originalLanguage String? // ISO 639-1: "fr", "en", etc.
  translatedBody String?
  translatedTo  String?
  // REQ-COL-03: Detected inline actions (dates, file refs)
  detectedActions String? // JSON: [{type:"calendar_invite", date:"2026-06-22T15:00:00Z"}]
  // REQ-SEC-EMP-01: DLP scan result
  dlpStatus     String   @default("clean") // clean | flagged | blocked
  dlpReason     String?
  isEdited      Boolean  @default(false)
  editedAt      DateTime?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomId, createdAt])
  @@index([parentMessageId])
  @@index([senderId])
}

// ─── REQ-COL-05/06/07: Voice & Video Calls ────────────────────────────
model CallLog {
  id            String   @id @default(cuid())
  callType      String   // audio | video
  provider      String   @default("native_webrtc") // native_webrtc | zoom | teams | webex
  initiatorId   String
  initiator     Employee @relation(fields: [initiatorId], references: [id], onDelete: Cascade)
  roomId        String?  // Optional link to a chat room
  meetingUrl    String?  // For external providers (Zoom/Teams/Webex deep link)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  durationSec   Int?
  status        String   @default("initiated") // initiated | answered | missed | completed | failed
  consentForRecording Boolean @default(false) // REQ-COL-07
  transcriptUrl String?  // REQ-COL-07: AI transcription
  transcriptStatus String @default("none") // none | requested | in_progress | ready | failed
  summaryText   String?  // AI-generated summary
  isE2EE        Boolean  @default(false) // REQ-SEC-EMP-03
  participants  CallParticipant[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([initiatorId])
  @@index([roomId])
  @@index([startedAt])
}

model CallParticipant {
  id            String   @id @default(cuid())
  callId        String
  call          CallLog  @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId        String
  user          Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime?
  leftAt        DateTime?
  connectionQuality String? // good | fair | poor

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([callId, userId])
  @@index([callId])
}

// ─── REQ-COL-08/09/10/11: Enterprise File Management ──────────────────
// Granular storage hierarchies: Personal / Project / Company Drive
model FileNode {
  id            String   @id @default(cuid())
  name          String
  driveType     String   // personal | project | company
  // Exactly one of these is set depending on driveType:
  ownerEmployeeId String? // personal drive
  owner          Employee? @relation("FileNode_Owner", fields: [ownerEmployeeId], references: [id], onDelete: Cascade)
  projectId     String?  // project drive
  companyId     String?  // company drive
  parentId      String?  // For nested folders (null = root)
  parent        FileNode? @relation("FileNode_Hierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      FileNode[] @relation("FileNode_Hierarchy")
  nodeType      String   // file | folder
  mimeType      String?
  sizeBytes     Int      @default(0)
  storagePath   String?  // Local FS path or external URL
  // REQ-COL-09: Versioning
  currentVersion Int     @default(1)
  versions       FileVersion[]
  // REQ-COL-11: External cloud sync
  externalProvider String? // sharepoint | google_drive | one_drive | dropbox
  externalId    String?
  externalSyncUrl String?
  externalSyncedAt DateTime?
  // REQ-SEC-EMP-01: DLP
  dlpScanStatus String   @default("pending") // pending | clean | flagged | blocked
  dlpFlags      String?  // JSON: ["SSN","CREDIT_CARD"]
  // REQ-SEC-EMP-02: GDPR anonymization tracking
  isAnonymized  Boolean  @default(false)
  // REQ-SEC-EMP-04: Watermark tracking
  watermarkEnabled Boolean @default(false)
  // REQ-6.1: Legal hold
  isUnderLegalHold Boolean @default(false)
  description   String?
  uploadedById  String
  uploadedBy    Employee @relation("FileNode_Uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  shareLinks    FileShareLink[]
  watermarkAccesses WatermarkAccessLog[]
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([driveType, ownerEmployeeId])
  @@index([driveType, projectId])
  @@index([driveType, companyId])
  @@index([parentId])
}

model FileVersion {
  id            String   @id @default(cuid())
  fileId        String
  file          FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber Int
  sizeBytes     Int
  storagePath   String
  mimeType      String?
  checksum      String?  // SHA-256 for integrity
  uploadedById  String
  uploadedBy    Employee @relation("FileVersion_Uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  changeLog     String?  // e.g. "Updated salary table"
  isActive      Boolean  @default(true) // false = soft-deleted version

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fileId, versionNumber])
}

// Track file shares (watermarking, access logging)
model FileShareLink {
  id            String   @id @default(cuid())
  fileId        String
  file          FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy     String
  creator       Employee @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  shareUrl      String   @unique
  shareType     String   @default("link") // link | user | email
  recipientEmail String?
  recipientUserId String?
  expiresAt     DateTime?
  passwordHash  String?
  downloadEnabled Boolean @default(true)
  watermarkEnabled Boolean @default(true) // REQ-SEC-EMP-04
  accessCount   Int      @default(0)
  lastAccessedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fileId])
  @@index([shareUrl])
}

// ─── REQ-AI-EMP-01: AI Knowledge Assistant (extends existing AIChatLog) ─
// Already have AIChatLog model — adding a metadata extension for HR context.
model AIKnowledgeQuery {
  id            String   @id @default(cuid())
  userId        String
  query         String
  intent        String?  // leave_balance | policy_lookup | payslip_query | benefits | directory
  responseText  String?
  contextJson   String?  // Snapshot of context used (employeeId, scopes)
  confidenceScore Float?
  wasHelpful    Boolean?
  feedbackText  String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([intent])
}

// ─── REQ-AI-EMP-02: Document Intelligence ─────────────────────────────
model DocumentIntelligenceResult {
  id            String   @id @default(cuid())
  fileId        String?  // Link to FileNode if uploaded via File Hub
  documentId    String?  // Link to Document if uploaded via Employee Documents
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  documentType  String?  // medical_certificate | invoice | receipt | id_proof | contract
    // Extracted structured data (JSON)
  extractedData String?  // {diagnosis, from_date, to_date, doctor_name, ...}
  rawOcrText    String?
  // Linked action — e.g. auto-filled leave request ID
  linkedEntityId String?
  linkedEntityType String? // leave_request | expense_claim | onboarding_task
  confidenceScore Float?
  status        String   @default("processed") // pending | processed | failed | needs_review
  reviewedById  String?
  reviewedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fileId])
  @@index([documentId])
  @@index([employeeId])
}

// ─── REQ-AI-EMP-03: Chat Summarization ────────────────────────────────
model ChatSummary {
  id            String   @id @default(cuid())
  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  summaryType   String   @default("daily") // daily | weekly | on_demand
  periodStart   DateTime
  periodEnd     DateTime
  summaryText   String
  keyPoints     String?  // JSON array of bullet points
  actionItems   String?  // JSON array of action items
  mentionedUsers String? // JSON array of user IDs mentioned
  generatedFor  String   // User ID who requested the summary
  messageCount  Int

  createdAt     DateTime @default(now())

  @@index([roomId, periodStart])
}

// ─── REQ-AI-EMP-04: Sentiment Analysis ────────────────────────────────
model SentimentAnalysis {
  id            String   @id @default(cuid())
  // Scope: 'room' | 'team' | 'company' | 'department'
  scope         String
  scopeId       String?  // Room/Team/Company/Department ID
  periodStart   DateTime
  periodEnd     DateTime
  // Sentiment scores 0-100
  positivityScore Float?
  negativityScore Float?
  toxicityScore Float?
  burnoutRiskScore Float?  // Composite: low activity + negative sentiment
  messageCount  Int
  participantCount Int
  // Aggregated signals — anonymous aggregates only (privacy preserving)
  topNegativeKeywords String? // JSON array
  topPositiveKeywords String? // JSON array
  alertTriggered Boolean @default(false)
  alertReason   String?

  createdAt     DateTime @default(now())

  @@index([scope, scopeId, periodStart])
}

// ─── Super & Tenant Admin (Section 6) ─────────────────────────────────
// REQ-6.1: Global Storage Quotas — per Parent Company (Tenant)
model StorageQuota {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  totalQuotaBytes Int    @default(10737418240) // 10 GB default
  usedQuotaBytes Int     @default(0)
  // Per-drive-type allocation
  personalQuotaBytes Int @default(1073741824) // 1 GB per employee
  projectQuotaBytes Int @default(5368709120)  // 5 GB per project
  companyQuotaBytes Int @default(2147483648)  // 2 GB per sub-company
  quotaAlertThreshold Float @default(0.85) // Alert at 85% usage
  lastRecalculatedAt DateTime?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// REQ-6.1: eDiscovery / Legal Hold
model LegalHold {
  id            String   @id @default(cuid())
  tenantId      String
  initiatedBy   String   // Super Admin user ID
  targetUserId  String?  // User under hold (optional — can be project/company-wide)
  targetRoomId  String?
  targetFileId  String?
  caseReference String?  // Legal case ID
  reason        String
  startDate     DateTime @default(now())
  endDate       DateTime? // Null = ongoing hold
  status        String   @default("active") // active | released | superseded
  releasedBy    String?
  releasedAt    DateTime?
  releaseReason String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([targetUserId])
}

// REQ-6.1: Feature Toggles (already have FeatureFlag — extending with quota context)
// Using a separate model for collaboration-specific toggles to keep concerns isolated.
model CollaborationFeatureFlag {
  id            String   @id @default(cuid())
  tenantId      String
  featureKey    String   // native_calling | ai_translation | file_preview | webrtc_group_calls | ...
  isEnabled     Boolean  @default(true)
  // Per-tenant load-management limits
  maxCallDurationMin Int @default(60)
  maxFileUploadMB Int    @default(100)
  maxChatAttachments Int @default(10)
  configuredBy  String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

// REQ-6.2: Communication Governance — auto-delete rules per room type
model CommunicationPolicy {
  id            String   @id @default(cuid())
  tenantId      String
  policyKey     String   // announcement_creators | message_retention | file_retention
  policyValue   String   // JSON: e.g. {"allowed_roles":["tenant_admin","hr_admin"]}
  appliesToRoomType String? // direct | group | project | announcement | all
  isActive      Boolean  @default(true)
  updatedBy     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, policyKey])
  @@index([tenantId])
}

// REQ-6.2: Storage Analytics snapshot (per sub-company / project)
model StorageAnalytics {
  id            String   @id @default(cuid())
  tenantId      String
  companyId     String?
  projectId     String?
  driveType     String   // personal | project | company
  totalBytes    Int      @default(0)
  fileCount     Int      @default(0)
  // Top consumers
  topFiles      String?  // JSON array of {fileId, name, sizeBytes}
  // Trends
  growthLast30Days Float? // Percentage growth
  cleanupCandidates Int?  // Files not accessed in 90+ days
  snapshotDate  DateTime @default(now())

  createdAt     DateTime @default(now())

  @@index([tenantId, snapshotDate])
  @@index([companyId, driveType])
}

// ─── REQ-SEC-EMP-01: DLP (Data Loss Prevention) ───────────────────────
model DLPScanLog {
  id            String   @id @default(cuid())
  // Source: chat_message | file_upload | file_share
  sourceType    String
  sourceId      String   // Message ID / File ID
  userId        String   // Who triggered the scan
  user          Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Detection results
  patterns      String?  // JSON: ["CREDIT_CARD","SSN","PHONE","EMAIL"]
  riskScore     Float    @default(0) // 0-100
  action        String   @default("allow") // allow | flag | block
  reasonText    String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewAction  String?  // dismissed | confirmed_violation | escalated

  createdAt     DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([userId])
  @@index([action])
}

// ─── REQ-SEC-EMP-02: GDPR Right to Be Forgotten ───────────────────────
// Tracks anonymization workflow when an employee exits.
model GDPRAnonymizationRequest {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy   String
  reason        String   // employee_exit | gdpr_request | legal_order
  status        String   @default("pending") // pending | in_progress | completed | failed
  // What was anonymized
  anonymizedFields String? // JSON: ["name","email","phone","ssn"]
  retainedFields String?  // JSON: ["payroll_records"] — kept for statutory period
  retentionPeriodYears Int @default(7) // REQ-SEC-EMP-02: 7 years
  scheduledPurgeDate DateTime? // When retained data should be purged
  completedAt   DateTime?
  failedReason  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ─── REQ-SEC-EMP-04: Watermarking ─────────────────────────────────────
model WatermarkAccessLog {
  id            String   @id @default(cuid())
  fileId        String
  file          FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId        String
  user          Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail     String   // Captured at access time (in case user is later anonymized)
  userIp        String?
  userAgent     String?
  watermarkText String   // The watermark applied (email + timestamp)
  accessType    String   @default("view") // view | download | print
  snapshotUrl   String?  // Optional screenshot capture for high-sensitivity docs

  createdAt     DateTime @default(now())

  @@index([fileId, createdAt])
  @@index([userId])
}

// ============ AI RECRUITMENT / ATS / PREBOARDING / ONBOARDING (Addendum) ============
// Backs REQ-PORT-04, REQ-SRC-01..06, REQ-ATS-01..06, REQ-AI-INT-01..08,
// REQ-OFR-01..04, REQ-ONB-01..09, REQ-SEC-REC-01..04, plus
// Tenant-Admin Recruitment Analytics. Added 2026-06-21.

// ─── REQ-SRC-05: Employee referral tracking ───
model Referral {
  id                    String   @id @default(cuid())
  jobPostingId          String
  jobPosting            JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  referrerEmployeeId    String
  referrerEmployee      Employee @relation(fields: [referrerEmployeeId], references: [id])
  candidateName         String
  candidateEmail        String
  candidatePhone        String?
  candidateResume       String?
  notes                 String?
  bonusAmount           Float?
  bonusCurrency         String   @default("INR")
  trackToken            String   @unique @default(cuid())
  clickCount            Int      @default(0)
  // pending | applied | interviewed | offered | hired | rejected | bonus_paid
  status                String   @default("pending")
  hiredAt               DateTime?
  bonusPaidAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([jobPostingId])
  @@index([referrerEmployeeId])
  @@index([trackToken])
  @@index([status])
}

// ─── REQ-SEC-REC-04: Candidate consent management ───
model CandidateConsent {
  id            String   @id @default(cuid())
  candidateEmail String
  tenantId      String
  // resume_processing | background_check | ai_evaluation | video_recording | marketing | data_retention
  purpose       String
  grantedAt     DateTime @default(now())
  withdrawnAt   DateTime?
  version       String   @default("1.0") // consent-text version
  ipAddress     String?
  userAgent     String?
  source        String   @default("careers_portal") // careers_portal | candidate_portal | email_link

  @@index([candidateEmail, tenantId])
  @@index([purpose])
}

// ─── REQ-SEC-REC-03: PII masking policy for hiring panel ───
model CandidatePiiPolicy {
  id              String @id @default(cuid())
  tenantId        String
  // dob | gender | photo | address | phone | email | aadhaar | ssn | sin
  field           String
  // JSON array of role keys, e.g. '["hr_manager","recruiter"]'
  visibleToRoles  String
  // hash | partial | hidden | full
  maskingStrategy String @default("hidden")
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([tenantId, field])
}

// ─── REQ-ATS-01/02: Real resume parsing (multi-format, multi-lingual) ───
// Stored as a separate table so multiple parse attempts (re-parse after edits)
// can coexist. JobApplication points to the latest via resumeParsedId.
model ResumeParse {
  id              String   @id @default(cuid())
  jobApplicationId String
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  // raw extracted text
  rawText         String
  // detected source language code (ISO 639-1): en, hi, de, ja, es, fr, ar, ...
  language        String?
  // AI-extracted structured fields (JSON)
  parsedData      String   // { name, email, phone, skills[], education[], experience[], certifications[], summary }
  // confidence 0..1 from the AI extraction
  confidence      Float    @default(0)
  // pdf | docx | doc | text | unknown
  sourceFormat    String   @default("unknown")
  parseError      String?
  createdAt       DateTime @default(now())

  @@index([jobApplicationId])
}

// ─── REQ-ATS-04/06: Candidate-facing portal auth + messaging ───
model CandidatePortalUser {
  id              String   @id @default(cuid())
  candidateEmail  String
  candidateName   String
  // OTP-based login — no password. OTPs expire in 15 minutes.
  currentOtpHash  String?
  otpExpiresAt    DateTime?
  lastLoginAt     DateTime?
  // Token for "magic link" login from email
  magicToken      String?  @unique
  magicExpiresAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([candidateEmail])
}

model CandidateMessage {
  id              String   @id @default(cuid())
  // threaded conversation — root messages have null parentMessageId
  parentMessageId String?
  parentMessage   CandidateMessage? @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: NoAction)
  replies         CandidateMessage[] @relation("MessageThread")

  candidateEmail  String
  // null senderId = candidate sent it; non-null = HR user sent it
  senderUserId    String?
  senderName      String
  senderRole      String   @default("candidate") // candidate | hr | recruiter | hiring_manager
  body            String
  // optional attachment URL (uploaded file)
  attachmentUrl   String?
  attachmentName  String?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([candidateEmail])
  @@index([parentMessageId])
  @@index([senderUserId])
}

// ─── REQ-AI-INT-02: Candidate sentiment & engagement scoring ───
model CandidateSentimentScore {
  id              String   @id @default(cuid())
  jobApplicationId String
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  // positive | neutral | negative | mixed
  sentiment       String   @default("neutral")
  // 0..100 — engagement quality (responsiveness + tone)
  engagementScore Int      @default(50)
  // 0..100 — risk of ghosting / rejection
  dropoffRisk     Int      @default(50)
  // free-text rationale from the AI
  rationale       String?
  // source: chat_screening | video_interview | email_response
  source          String   @default("chat_screening")
  createdAt       DateTime @default(now())

  @@index([jobApplicationId])
}

// ─── REQ-AI-INT-07: Time-stamped interview feedback ───
model InterviewFeedback {
  id              String   @id @default(cuid())
  interviewId     String
  // interview relation is implicit (Interview model has no back-relation slot today);
  // we store the id and join manually.
  interviewerId   String?
  interviewerName String
  // timestamp in seconds within the video / chat transcript this feedback refers to
  timestampSec    Int?
  // positive | negative | neutral | concern | highlight
  sentiment       String   @default("neutral")
  body            String
  // optional rating 1..5 on the specific moment
  rating          Int?
  createdAt       DateTime @default(now())

  @@index([interviewId])
  @@index([interviewerId])
}

// ─── REQ-OFR-01: Dynamic offer letter templates ───
model OfferTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  // ISO country code this template is for: US, IN, UK, AE, DE, * (wildcard)
  country         String   @default("*")
  // language code for the template body
  language        String   @default("en")
  // HTML / Markdown body with {{placeholders}} — e.g. {{candidateName}}, {{position}}, {{salary}}, {{currency}}, {{joiningDate}}, {{probationDays}}, {{reportingTo}}
  body            String
  // optional header / footer HTML
  header          String?
  footer          String?
  // legal clauses as JSON array of {title, body} pairs
  clauses         String?
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, country])
  @@index([isActive])
}

// ─── REQ-OFR-04: Decline analysis micro-survey ───
model OfferDeclineSurvey {
  id              String   @id @default(cuid())
  offerId         String   @unique
  offer           Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // candidate-facing token so they can submit without logging in
  token           String   @unique @default(cuid())
  // compensation_too_low | accepted_another_offer | location | role_fit | benefits | counter_offer | personal | other
  primaryReason   String?
  // free-text
  comments        String?
  // would they reconsider in future?
  openToFuture    Boolean?
  submittedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([offerId])
}

// ─── REQ-ONB-01/05/08: Onboarding task templates + cascade wiring ───
model OnboardingTaskTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  task            String
  // general | it_setup | hr_docs | training | introduction | buddy_setup | payroll_setup | project_allocation
  category        String   @default("general")
  // due X days after joining (negative = pre-joining)
  dueOffsetDays   Int      @default(0)
  // optional designation-level filter
  appliesToRole   String?
  // optional department filter
  appliesToDepartment String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, isActive])
}

// ─── REQ-SRC-01/02/03: Job board multi-posting + auto-close on hire ───
model JobBoardPosting {
  id              String   @id @default(cuid())
  jobPostingId    String
  jobPosting      JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  // linkedin | indeed | glassdoor | stepstone | naukri | internal_careers
  board           String
  // external board's job id (returned after posting)
  externalJobId   String?
  // pending | posted | closed | failed | expired
  status          String   @default("pending")
  // live URL on the external board
  externalUrl     String?
  // last sync payload (JSON)
  lastSyncPayload String?
  lastSyncedAt    DateTime?
  errorMessage    String?
  postedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([jobPostingId, board])
  @@index([jobPostingId])
  @@index([board, status])
}

// ─── REQ-ONB-03: Background verification vendor integration ───
model BackgroundCheck {
  id              String   @id @default(cuid())
  preboardingCandidateId String
  preboardingCandidate PreboardingCandidate @relation(fields: [preboardingCandidateId], references: [id], onDelete: Cascade)
  // vendor: sterling | hireright | internal | manual
  vendor          String   @default("manual")
  // package: basic | standard | enhanced | executive
  package         String   @default("standard")
  // candidate consent reference (links to CandidateConsent row with purpose=background_check)
  consentId       String?
  // pending | initiated | in_progress | cleared | failed | cancelled
  status          String   @default("pending")
  // external vendor's case id
  externalCaseId  String?
  reportUrl       String?
  summary         String?
  initiatedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([preboardingCandidateId])
  @@index([status])
}

// ─── REQ-ONB-04: Welcome series email tracking ───
model WelcomeSeriesEmail {
  id              String   @id @default(cuid())
  preboardingCandidateId String
  preboardingCandidate PreboardingCandidate @relation(fields: [preboardingCandidateId], references: [id], onDelete: Cascade)
  // day_0 | day_3 | day_7 | day_before_joining | day_1_welcome
  sequenceKey     String
  subject         String
  body            String
  // pending | sent | failed | skipped
  status          String   @default("pending")
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@unique([preboardingCandidateId, sequenceKey])
  @@index([preboardingCandidateId])
  @@index([status])
}


// =====================================================================
// AI Attendance & Leave Management Addendum
// Covers REQ-ATT-04, REQ-ATT-06, REQ-REG-01..03, REQ-PERM-01..02,
// REQ-GATE-01..02, REQ-OT-02..03, REQ-CFG-02..03, REQ-CFG-05..06,
// REQ-LVE-02..04, REQ-LVE-07, REQ-AI-ATT-03..04, REQ-SEC-ATT-04
// =====================================================================

// ── Geofence — drawn perimeter around an office location (REQ-ATT-04) ──
model Geofence {
  id          String   @id @default(cuid())
  name        String
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // GeoJSON-like polygon stored as JSON: { type: "Polygon", coordinates: [[[lat,lng], ...]] }
  polygon     Json
  centerLat   Float
  centerLng   Float
  radiusMeters Int    @default(200)   // also used for circular geofences
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
}

// ── Attendance Regularization (REQ-REG-01, REQ-REG-02, REQ-REG-03) ──
model AttendanceRegularization {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  punchType   String   // "check_in" | "check_out"
  requestedTime DateTime
  reason      String
  // Optional AI suggestion snapshot (REQ-REG-02)
  aiSuggestedTime DateTime?
  aiConfidence Float?
  // Is this on a weekend/holiday? (REQ-REG-03 — needs higher-level approval)
  isWeekend   Boolean  @default(false)
  isHoliday   Boolean  @default(false)

  status      String   @default("pending") // pending, approved, rejected
  approvedBy  String?
  approvedAt  DateTime?
  comments    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ── Hourly Permission / Short-Leave (REQ-PERM-01, REQ-PERM-02) ──
model HourlyPermission {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  startTime   DateTime
  endTime     DateTime
  hours       Float    // 0.25, 0.5, 1.0, 1.5, etc. (REQ-PERM-01: increments of 15/30 min)
  reason      String

  // REQ-PERM-02: deducted from daily target → adjusted required check-out time
  adjustedCheckOut DateTime?

  status      String   @default("pending") // pending, approved, rejected, auto_approved
  approvedBy  String?
  approvedAt  DateTime?
  autoApproved Boolean @default(false)     // REQ-AI-ATT-04: AI auto-approval

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

// ── Gatepass — physical movement token (REQ-GATE-01, REQ-GATE-02) ──
model Gatepass {
  id          String   @id @default(cuid())
  employeeId  String?  // null for visitor/contractor
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // REQ-GATE-02: visitor/contractor fields
  visitorName    String?
  visitorCompany String?
  visitorPhone   String?
  projectId      String?   // logged against a project for compliance

  type        String   // "early_departure" | "late_arrival" | "visitor" | "contractor"
  requestedAt DateTime
  actualOutTime  DateTime?
  actualInTime   DateTime?

  // Two-tier approval (REQ-GATE-01): manager + security
  managerStatus   String @default("pending") // pending, approved, rejected
  managerApprovedBy String?
  managerApprovedAt DateTime?
  securityStatus   String @default("pending")
  securityApprovedBy String?
  securityApprovedAt DateTime?
  // Final state — only open when both manager + security have approved
  gateOpenedAt    DateTime?

  reason      String
  status      String   @default("pending") // pending, approved, rejected, completed, cancelled

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([requestedAt])
}

// ── Pre-OT Approval (REQ-OT-02) — distinct from OvertimeRecord (actual OT) ──
model OvertimeRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  startTime   DateTime
  endTime     DateTime
  estimatedHours Float
  reason      String
  projectId   String?

  // REQ-OT-03: convert OT to Comp-Off instead of payout
  payoutPreference String @default("payout") // "payout" | "comp_off"
  compOffCreditedId String? // FK to CompOffLeave when converted
  compOffCreditedAt DateTime?

  status      String   @default("pending") // pending, approved, rejected, cancelled
  approvedBy  String?
  approvedAt  DateTime?
  comments    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

// ── Comp-Off Leave (REQ-OT-03) — earned from OT conversion ──
model CompOffLeave {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  earnedDate  DateTime
  hours       Float
  source      String   @default("overtime") // "overtime" | "holiday_work" | "weekend_work"
  sourceOvertimeRequestId String?  // back-link to OvertimeRequest
  expiryDate  DateTime?  // Comp-offs typically expire after a defined window
  used        Float    @default(0)
  status      String   @default("active") // active, expired, used, partially_used

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ── WFH Snapshot — single GPS coordinate at check-in/out (REQ-ATT-06, REQ-SEC-ATT-01) ──
model WfhAttendanceSnapshot {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  punchType   String   // "check_in" | "check_out"
  punchTime   DateTime
  latitude    Float
  longitude   Float
  // Optional — AI activity summary (REQ-ATT-07)
  activityChats     Int @default(0)
  activityTimesheets Float @default(0)
  activityEmails    Int @default(0)
  aiBurnoutRisk     Float?  // 0..1, optional

  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// ── Rotational Roster (REQ-CFG-02) — auto-rotating shifts ──
model RotationalRoster {
  id          String   @id @default(cuid())
  name        String
  description String?

  // Pattern is an ordered list of shift IDs the employee rotates through
  // e.g. ["shift_morning_id", "shift_morning_id", "shift_night_id"]
  pattern       Json
  rotationUnit  String @default("week") // "day" | "week"
  startDate     DateTime

  isActive      Boolean @default(true)
  assignments   EmployeeRosterAssignment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Employee → Roster assignment with a "current offset" into the pattern
model EmployeeRosterAssignment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  rosterId    String
  roster      RotationalRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  // Index into roster.pattern — advances each rotation unit
  currentOffset Int   @default(0)
  startDate    DateTime
  endDate      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, rosterId])
  @@index([employeeId])
}

// ── Attendance Policy with rounding & grace rules (REQ-CFG-03) ──
model AttendancePolicyConfig {
  id              String   @id @default(cuid())
  name            String
  // REQ-CFG-03: rounding rules
  roundEnabled    Boolean  @default(false)
  roundMinutes    Int      @default(15)  // round to nearest 15 minutes
  roundDirection  String   @default("nearest") // "nearest" | "up" | "down"
  // Late-coming grace (minutes)
  lateGraceMinutes Int     @default(10)
  // Early-departure grace (minutes)
  earlyGraceMinutes Int    @default(10)
  // REQ-OT-01: auto-OT enabled
  autoOvertimeEnabled Boolean @default(true)
  overtimeThresholdMinutes Int @default(480) // 8 hours
  // REQ-AI-ATT-04: auto-approval rules
  autoApprovePermissionMinutes Int @default(0)  // 0 = disabled; e.g. 30 = auto-approve permissions ≤ 30 min
  autoApproveMinAttendancePct Float @default(90) // employee needs ≥ 90% attendance to qualify
  // WFH policy (REQ-ATT-06/07)
  wfhActivityMonitoringEnabled Boolean @default(false)
  wfhInactivityThresholdHours Int @default(4) // flag if zero activity for 4h block

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Leave Encashment Request (REQ-LVE-07) ──
model LeaveEncashmentRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  days        Float
  // Calculation basis: basic, gross, or monthly_salary
  basis       String   @default("basic") // basic | gross | monthly_salary
  ratePerDay  Float
  amount      Float
  // Country-specific tax implications stored as JSON
  taxImplications Json?

  status      String   @default("pending") // pending, approved, rejected, processed
  approvedBy  String?
  approvedAt  DateTime?
  payrollRunId String?  // Linked to payroll run when paid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ── Leave Attachment (REQ-LVE-02) — medical certs, supporting docs ──
model LeaveAttachment {
  id          String   @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  // REQ-SEC-ATT-03: medical certificates stored in a restricted container
  isMedical   Boolean  @default(false)
  // Locked — only Occupational Health officers can unlock
  locked      Boolean  @default(false)
  uploadedAt  DateTime @default(now())

  @@index([leaveRequestId])
}

// ── Optional Holiday Election (REQ-CFG-05) ──
model OptionalHolidayElection {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  holidayId   String
  holiday     Holiday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  year        Int
  selectedAt  DateTime @default(now())

  @@unique([employeeId, holidayId])
  @@index([employeeId])
}

// ── Matrix Routing Rule (REQ-CFG-06) ──
// Routes leave/OT/gatepass approval based on project assignment for that day
model ApprovalRoutingRule {
  id          String   @id @default(cuid())
  name        String
  // Request type this rule applies to: "leave" | "overtime" | "gatepass" | "permission"
  requestType String
  // If the employee is allocated to this project on the request date, route to alternateManagerId
  projectId   String?
  alternateManagerId String?
  // Fallback — if no project match, use primary manager
  priority    Int      @default(100)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestType])
  @@index([projectId])
}

// ── Burnout Flag (REQ-AI-ATT-03) ──
model BurnoutFlag {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Risk score 0..1
  riskScore   Float
  riskLevel   String   // "low" | "moderate" | "high" | "critical"
  // Contributing factors (JSON)
  factors     Json     // { overtime: 1.2, leaveUsage: 0.3, activityScore: 0.95 }
  recommendations String?
  notifiedManager Boolean @default(false)
  acknowledgedAt DateTime?

  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([riskLevel])
}

// ── Attendance Audit Trail (REQ-SEC-ATT-04) ──
// Append-only log of every change to an attendance record
model AttendanceAuditLog {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceId String?

  action      String   // "manual_edit" | "regularization_approved" | "shift_change" | "mass_correction"
  // Original + changed data, JSON snapshot
  beforeData  Json?
  afterData   Json?
  changedBy   String
  changedByIp String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([action])
  @@index([createdAt])
}
