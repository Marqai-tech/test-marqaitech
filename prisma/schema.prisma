  isTaxable         Boolean @default(true)
  isStatutory       Boolean @default(false)
  maxLimit          Float?
  sortOrder         Int @default(0)
  status            String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salaryStructureId])
}

