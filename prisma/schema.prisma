generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ============ SaaS MULTI-TENANT CORE ============

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  plan        String   @default("starter") // starter, professional, enterprise
  status      String   @default("active")
  logo        String?
  country     String?
  currency    String   @default("INR")
  timezone    String   @default("UTC")

  // ─── SRS REQ-GL-01 / REQ-TA-09: Multi-lingual support ───
  // Default UI language for this tenant. Cascades to sub-companies as default.
  // Examples: 'en', 'es', 'fr', 'pt-BR', 'de'.
  language    String   @default("en")

  // ─── SRS REQ-GL-03 / REQ-GL-04: Multi-currency support ───
  // The tenant's base currency for consolidated group reporting.
  // Sub-companies operating in other currencies auto-convert to this.
  baseCurrency String  @default("INR")

  // ─── SRS REQ-GL-06: Multi-country data residency ───
  // Server region where this tenant's data is stored (e.g. 'us-east-1', 'eu-west-1').
  // Super admin sets this at tenant creation per GDPR/local compliance.
  dataRegion  String?

  // ─── SRS REQ-SA-02: Subscription plan limits ───
  // Maximum user seats allowed under this tenant's plan. 0 = unlimited.
  subscriptionSeats    Int @default(0)
  // Maximum storage in MB allowed under this tenant's plan. 0 = unlimited.
  subscriptionStorage  Int @default(0)

  // ─── Quota / Barrier fields (set by super_admin) ───
  // Maximum number of companies this tenant is allowed to create under all its groups.
  // 0 = unlimited. When tenant_admin tries to create a company beyond this count,
  // the API rejects the request.
  maxCompaniesAllowed Int @default(0)

  // ─── Candidate Portal settings (REQ-CAND / REQ-STAT / REQ-AI-RES) ───
  // Tenant-admin toggles for the candidate-facing portal. All default off so
  // the tenant opts in to each AI-driven candidate experience explicitly.
  // Whether AI-generated rejection feedback is shown to candidates (REQ-STAT-05).
  // When true, HR can draft AI feedback, review it, then publish to the candidate (REQ-STAT-06).
  aiFeedbackEnabled        Boolean  @default(false)
  // Minimum AI Match Score (0-100) required for a candidate to bypass the
  // initial HR screen and go straight to a hiring manager (REQ-AI-RES-03 / tenant config).
  // 0 = no auto-bypass (every application is reviewed by HR).
  resumeScoreThreshold     Int      @default(0)
  // Whether candidates in this tenant's talent pool can be searched across
  // sub-companies within the same parent group (REQ-STAT-01 / tenant config).
  talentPoolCrossCompanyEnabled Boolean @default(false)
  // Configurable retake limit per interview question (REQ-INT-07). 0 = no retakes.
  videoInterviewRetakeLimit Int     @default(0)
  // Auto-delete video interview recordings after N days (REQ-SEC-CAND-03). 0 = keep forever.
  videoRetentionDays       Int      @default(90)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyGroups       CompanyGroup[]
  users               User[]
  notifications       Notification[]
  subscriptions       Subscription[]
  roles               Role[]
  settings         Setting[]
  candidates       Candidate[]
  featureFlags        FeatureFlag[]
  trialRegistrations  TrialRegistration[]
  tenantDatabase      TenantDatabase?
  configuration       TenantConfiguration?
  backupRecords       BackupRecord[]
}

// ============ PER-TENANT DATABASE ISOLATION ============
//
// Each tenant can have its own separate Neon database.
// The TenantDatabase record stores the connection details for that tenant's DB.
// When a tenant has a TenantDatabase record, the platform routes data queries
// to that tenant's dedicated database instead of the shared platform DB.
//
// This ensures complete data isolation between tenants - each tenant's
// employees, companies, payroll, etc. live in their own Neon database.
model TenantDatabase {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Neon database connection details
  // The pooled connection string used by the PrismaNeon adapter for serverless
  connectionString  String
  // Direct (non-pooled) connection string, stored for migrations/admin
  directUrl         String?
  // The name of the Neon database (e.g., "tenant_marqaitechgroup")
  databaseName      String
  // Neon branch ID if using branching (optional)
  neonBranchId      String?
  // Neon project ID that hosts this database
  neonProjectId     String?
  // Whether this tenant DB is active and receiving queries
  isActive          Boolean  @default(true)
  // When the database was provisioned
  provisionedAt     DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

// ============ BACKUP RECORDS ============

model BackupRecord {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Who triggered the backup
  triggeredBy   String   // user ID
  triggeredByName String  // user name/email for display

  // Backup details
  backupType    String   @default("manual") // manual, scheduled
  status        String   @default("completed") // completed, failed, in_progress

  // Summary stats
  totalTables   Int      @default(0)
  totalRecords  Int      @default(0)
  tableDetails  String?  // JSON string of [{table, count}]

  // Storage info
  storageLocation String? // e.g., "Neon branch", "S3 bucket", "local"
  fileSizeBytes  Int?     // estimated size
  backupNotes   String?  // any notes

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ============ SRS REQ-SA-05: FEATURE FLAGS ============
//
// Per-tenant feature toggles controlled by super_admin. Allows enabling /
// disabling specific AI modules, beta features, or plan-gated functionality
// without deploying code. Tenant inherits platform defaults; super_admin can
// override per tenant.
model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Stable machine key, e.g. 'ai_anomaly_detection', 'ai_smart_search',
  // 'predictive_analytics', 'auto_translation', 'sso_saml'.
  key       String

  // Human-readable label shown in the super admin UI.
  label     String

  // Whether the feature is currently enabled for this tenant.
  enabled   Boolean  @default(false)

  // Optional config payload (JSON-stringified) for tunable params.
  // e.g. '{"sensitivity":0.8}' for AI anomaly detection.
  config    String?

  // 'platform_default' flags are auto-seeded for every tenant and reflect the
  // platform-wide default. 'override' flags are explicit per-tenant overrides.
  source    String   @default("platform_default") // 'platform_default' | 'override'

  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model CompanyGroup {
  id       String @id @default(cuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ─── Employee strength barriers (set by super_admin) ───
  // Mode: 'per_company'  -> maxEmployees applies to EACH company in this group
  //       'group_total'  -> maxEmployees applies to the SUM of all employees across all companies in this group
  // null maxEmployees = unlimited
  employeeLimitMode String  @default("group_total") // 'per_company' | 'group_total'
  maxEmployees      Int?

  // Optional cap on how many companies can live under this group.
  // null = unlimited. (Tenant-level maxCompaniesAllowed still applies on top.)
  maxCompanies      Int?

  // Optional admin notes (e.g. "Sales cluster — cap at 200 staff")
  notes             String?

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Company {
  id             String @id @default(cuid())
  name           String
  code           String?
  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)

  registrationNo String?
  taxId          String?
  country        String?
  currency       String @default("INR")
  timezone       String @default("UTC")
  // SRS REQ-TA-02 / REQ-GL-01: Default UI language for this sub-company.
  // Inherits from the parent tenant by default; tenant_admin can override per company.
  language       String @default("en")
  address        String?
  city           String?
  state          String?
  zipCode        String?
  phone          String?
  email          String?
  website        String?
  logo           String?
  status         String @default("active")

  // ─── Per-company employee strength barrier (set by tenant_admin) ───
  // Optional hard cap on how many employees THIS specific company can hold.
  // null = unlimited (subject to the parent group's maxEmployees if mode=per_company).
  // When both group-level and company-level caps are set, the tighter one applies.
  maxEmployees           Int?

  // Declared / planned employee strength at company creation time (informational).
  // Used by tenant_admin as a soft target — does NOT block employee creation.
  plannedEmployeeCount   Int?

  branches        Branch[]
  departments     Department[]
  clients         Client[]
  vendors         Vendor[]
  projects        Project[]
  candidates           Candidate[]
  settings             Setting[]
  companyPolicies      CompanyPolicy[]
  gratuityLedgers      GratuityLedger[]
  salaryStructures SalaryStructure[]
  requisitions    Requisition[]
  roles           Role[]
  payrollDefinitions PayrollDefinition[]
  bankPaymentFiles BankPaymentFile[]
  invoices        Invoice[]
  okrs            OKR[]
  // Candidate Portal addendum: talent pool back-relation
  talentPoolCandidates CandidateTalentPool[]
  leaveTypes       LeaveType[]
  holidays         Holiday[]
  policies         Policy[]
  shifts           Shift[]

  // ─── Global Payroll Addendum back-references ───
  payrollRuns           PayrollRun[]
  dataResidencyPolicy   DataResidencyPolicy?
  minimumWageConfigs    MinimumWageConfig[]
  payrollAnomalies      PayrollAnomaly[]
  ghostEmployeeFlags    GhostEmployeeFlag[]

  // ─── Client/Vendor Addendum back-references ───
  clientBranches        ClientBranch[] @relation("ClientBranchCompany")
  purchaseOrders        PurchaseOrder[] @relation("POCompany")

  // ─── Marketplace Addendum back-references ───
  walletBudgetAllocations WalletBudgetAllocation[] @relation("WalletBudgetCompany")
  reportSchedules         ReportSchedule[]       @relation("ReportScheduleCompany")
  employeeMappings        EmployeeCompanyMapping[]
  attendancePolicyConfigs AttendancePolicyConfig[]
  leavePolicyRules        LeavePolicyRule[]
  attendancePolicyRules   AttendancePolicyRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyGroupId])
}

model Branch {
  id        String @id @default(cuid())
  name      String
  code      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  country  String?
  state    String?
  city     String?
  address  String?
  zipCode  String?
  phone    String?
  email    String?
  status   String @default("active")

  departments Department[]
  employees   Employee[]

  // ─── AI Attendance & Leave Addendum ───
  geofences         Geofence[]
  biometricDevices  BiometricDevice[]
  employeeMappings  EmployeeCompanyMapping[]
  leavePolicyRules      LeavePolicyRule[]
  attendancePolicyRules AttendancePolicyRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Department {
  id        String @id @default(cuid())
  name      String
  code      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  headId   String?
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  status String @default("active")

  designations Designation[]
  employees    Employee[]
  jobPostings  JobPosting[]
  projects     Project[]
  requisitions Requisition[]
  employeeMappings EmployeeCompanyMapping[]
  leavePolicyRules      LeavePolicyRule[]
  attendancePolicyRules AttendancePolicyRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
}

model Designation {
  id           String @id @default(cuid())
  title        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  level        Int    @default(1)
  minSalary    Float?
  maxSalary    Float?
  status       String @default("active")

  employees Employee[]
  requisitions Requisition[]
  employeeMappings EmployeeCompanyMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// ============ USER & AUTH ============

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  avatar   String?

  // tenantId is optional for super_admin users who operate at the platform level
  // and are not tied to any specific tenant. All other users (tenant_admin, admin, etc.)
  // must belong to a tenant.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role       String @default("admin") // super_admin, tenant_admin, admin
  status     String @default("active")
  lastLogin  DateTime?
  lastLogout DateTime?

  employee Employee?

  notifications      Notification[]
  auditLogs          AuditLog[]
  loginActivities    LoginActivity[]
  roleAssignments    UserRoleAssignment[]
  contractorAccounts Contractor[] @relation("ContractorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
}

// ============ EMPLOYEE CORE ============

model Employee {
  id             String @id @default(cuid())
  employeeId     String @unique
  firstName      String
  lastName       String
  email          String
  phone          String?
  avatar         String?

  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  designationId  String
  designation    Designation @relation(fields: [designationId], references: [id])
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId      String?

  // ─── REQ-EMP-04: Solid-line reporting manager ───
  // This is the primary manager who approves leave/attendance/timesheet requests.
  // DottedLineManager table handles secondary/dotted/project/functional managers.
  // This field is nullable so existing employees without a manager still work.
  reportingManagerId String?
  reportingManager   Employee? @relation("EmployeeReportsTo", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports       Employee[] @relation("EmployeeReportsTo")

  dateOfJoining  DateTime
  dateOfBirth    DateTime?
  gender         String?
  maritalStatus  String?
  nationality    String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  bloodGroup     String?
  emergencyContactName  String?
  emergencyContactPhone String?

  status         String @default("active") // active, on_leave, terminated, resigned

  bankName       String?
  bankAccountNo  String?
  bankIfscCode   String?
  panNumber      String?
  aadhaarNumber  String?
  taxId          String?

  salary         Float?
  salaryCurrency String @default("INR")

  // Policy & Structure Mappings
  leavePolicyId      String?
  attendancePolicyId String?
  travelPolicyId     String?
  salaryStructureId  String?

  // Relations
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  attendance        Attendance[]
  payrolls          Payroll[]
  documents         Document[]
  dependents        Dependent[]
  qualifications    Qualification[]
  experiences       Experience[]
  skills            EmployeeSkill[]
  performanceReviews PerformanceReview[]
  goals             Goal[]
  trainings         TrainingEnrollment[]
  assetAssignments  AssetAssignment[]
  incidentReports   IncidentReport[]
  travelRequests    TravelRequest[]
  expenseClaims     ExpenseClaim[]
  timesheets        Timesheet[]
  feedbacks         Feedback[]  @relation("FeedbackTo")
  givenFeedbacks    Feedback[]  @relation("FeedbackFrom")
  promotions        Promotion[]
  grievances        Grievance[]
  separations       Separation[]
  onboardingTasks   OnboardingTask[]
  reimbursements    Reimbursement[]
  projectAllocations ProjectAllocation[]
  projectMembers     ProjectMember[]
  fnfCalculations   FNFCalculation[]
  employeePaymentMethods EmployeePaymentMethod[]
  loans             Loan[]
  overtimeRecords   OvertimeRecord[]
  payrollHolds      PayrollHold[]
  transactionLines  PayrollTransactionLine[]
  payrollInputs     PayrollInput[]
  taxDeclarations   IncomeTaxDeclaration[]

  // ─── Global Payroll Addendum back-references (REQ-AI-PAY-01/03, REQ-7.2) ───
  payrollAdjustmentLogs  PayrollAdjustmentLog[]
  payrollAnomalies       PayrollAnomaly[]
  ghostEmployeeFlags     GhostEmployeeFlag[]
  crossBorderSecondments CrossBorderSecondment[]

  // ─── Employee Core & Collaboration back-references ───
  customFieldValues      EmployeeCustomFieldValue[]
  dottedLineManagers     DottedLineManager[]  @relation("DottedLineManager_Employee")
  managedDottedLines     DottedLineManager[]  @relation("DottedLineManager_Manager")
  teamMemberships        TeamMember[]

  // ─── AI Attendance & Leave Addendum back-references ───
  attendanceRegularizations AttendanceRegularization[]
  hourlyPermissions         HourlyPermission[]
  gatepasses                Gatepass[]
  overtimeRequests          OvertimeRequest[]
  compOffLeaves             CompOffLeave[]
  wfhSnapshots              WfhAttendanceSnapshot[]
  wfhRequests               WfhRequest[]
  rosterAssignments         EmployeeRosterAssignment[]
  leaveEncashmentRequests   LeaveEncashmentRequest[]
  optionalHolidayElections  OptionalHolidayElection[]
  burnoutFlags              BurnoutFlag[]
  attendanceAuditLogs       AttendanceAuditLog[]
  biometricEnrollments      BiometricEnrollment[]
  biometricPunches          BiometricPunch[]

  // ─── Marketplace Addendum back-references ───
  wallets                   Wallet[]
  marketplaceOrders         MarketplaceOrder[]
  insurancePolicies         InsurancePolicy[]
  insuranceClaims           InsuranceClaim[]   @relation("ClaimEmployee")
  ewaRequests               EWARequest[]       @relation("EWAEmployee")
  loanMarketListings        LoanMarketplaceListing[] @relation("LoanMktEmployee")
  giftsReceived             Gift[]             @relation("GiftRecipient")
  giftsSent                 Gift[]             @relation("GiftSender")
  rewardPointsLedger        RewardPointsLedger[] @relation("RewardPointsEmployee")
  marketplaceFraudFlags     MarketplaceFraudFlag[] @relation("FraudEmployee")
  financialStressFlags      FinancialStressFlag[] @relation("StressEmployee")
  walletBudgetAllocations   WalletBudgetAllocation[] @relation("WalletBudgetEmployee")
  clientFeedbacks           ClientFeedback[]      @relation("ClientFeedbackEmployee")
  personalizedCatalogCaches PersonalizedCatalogCache[] @relation("PersonalizedCatalogEmployee")
  utilizationSnapshots      ProjectUtilizationSnapshot[] @relation("UtilizationEmployee")

  // ─── AI Recruitment back-references ───
  referrals              Referral[]
  teamLeads              Team[]
  socialProfiles         SocialProfile[]
  calendarSyncs          CalendarSync[]
  chatMessages           ChatMessage[]
  callLogs               CallLog[]
  callParticipations     CallParticipant[]
  fileNodesOwned         FileNode[]           @relation("FileNode_Owner")
  fileVersionsUploaded   FileVersion[]        @relation("FileVersion_Uploader")
  fileSharesCreated      FileShareLink[]
  fileNodesUploaded      FileNode[]           @relation("FileNode_Uploader")
  documentIntelligenceResults DocumentIntelligenceResult[]
  gdprAnonymizationRequests GDPRAnonymizationRequest[]
  dlpScanLogs            DLPScanLog[]
  watermarkAccessLogs    WatermarkAccessLog[]

  // ─── P0 fix back-references (added 2026-06-20) ───
  exitRequests      ExitRequest[]
  okrs              OKR[]
  exitInterviews    ExitInterview[]
  surveyResponses   SurveyResponse[]
  recognitionsReceived Recognition[]
  companyMappings      EmployeeCompanyMapping[]

  bankAccounts           BankAccount[]
  gratuityLedgers        GratuityLedger[]

  // ─── Collaboration Productivity back-references ───
  calendarEvents         CalendarEvent[]     @relation("CalendarEvent_Creator")
  emailMessages          EmailMessage[]      @relation("EmailMessage_Sender")
  todoTasksCreated       TodoTask[]          @relation("TodoTask_Creator")
  todoTasksAssigned      TodoTask[]          @relation("TodoTask_Assignee")
  notesCreated           Note[]              @relation("Note_Creator")
  socialPosts            SocialPost[]        @relation("SocialPost_Author")
  socialComments         SocialComment[]     @relation("SocialComment_Author")
  kanbanBoardsCreated    KanbanBoard[]       @relation("KanbanBoard_Creator")
  kanbanCardsAssigned    KanbanCard[]        @relation("KanbanCard_Assignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([reportingManagerId])
}

model Dependent {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name       String
  relation   String
  dateOfBirth DateTime?
  gender     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Qualification {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  degree      String
  institution String
  year        Int
  percentage  Float?
  certificate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Experience {
  id          String @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  company     String
  designation String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model EmployeeSkill {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  skill      String
  level      String @default("intermediate") // beginner, intermediate, advanced, expert
  yearsOfExp Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ============ RECRUITMENT ============

model JobPosting {
  id          String @id @default(cuid())
  title       String
  departmentId String
  department  Department @relation(fields: [departmentId], references: [id])

  position    String
  location    String?
  type        String @default("full-time") // full-time, part-time, contract, internship
  experience  String?
  salary      String?
  description String
  requirements String?
  status      String @default("open") // open, closed, on_hold, filled
  postedDate  DateTime @default(now())
  closingDate DateTime?
  vacancies   Int @default(1)

  applications JobApplication[]
  referrals    Referral[]
  boardPostings JobBoardPosting[]
  // Candidate Portal addendum back-relations
  savedByCandidates CandidateSavedJob[]
  jobAlerts          CandidateJobAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

model JobApplication {
  id           String @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  candidateName  String
  candidateEmail String
  candidatePhone String?
  resume         String?
  coverLetter    String?
  source         String @default("website") // website, referral, linkedin, indeed, other
  status         String @default("applied") // applied, screening, interview, offered, hired, rejected
  appliedDate    DateTime @default(now())
  rating         Int?
  notes          String?
  interviewDate  DateTime?
  expectedSalary String?

  interviews    Interview[]
  resumeParses  ResumeParse[]
  sentimentScores CandidateSentimentScore[]
  // Candidate Portal addendum back-relations
  resumeOptimization CandidateResumeOptimization?
  aiFeedback         CandidateAiFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobPostingId])
  @@index([candidateId])
  @@index([status])
}

model Interview {
  id              String @id @default(cuid())
  jobApplicationId String
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  type       String @default("technical") // technical, hr, managerial, final
  date       DateTime
  time       String?
  duration   Int?
  location   String?
  meetingUrl String?
  interviewer String?
  status     String @default("scheduled") // scheduled, completed, cancelled, rescheduled
  feedback   String?
  score      Int?
  aiScore    Int?
  aiFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobApplicationId])
}

// ============ ONBOARDING ============

model OnboardingTask {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  task       String
  category   String @default("general") // general, it_setup, hr_docs, training, introduction, buddy_setup, payroll_setup, project_allocation
  status     String @default("pending") // pending, in_progress, completed
  dueDate    DateTime?
  completedDate DateTime?
