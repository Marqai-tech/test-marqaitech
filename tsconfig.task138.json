{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/app/(dashboard)/employees/page.tsx",
    "src/app/(dashboard)/employees/[id]/page.tsx",
    "src/app/(dashboard)/employees/dashboard/page.tsx",
    "src/app/(dashboard)/my-profile/page.tsx",
    "src/app/(dashboard)/social-feed/page.tsx",
    "src/app/(dashboard)/collaboration/settings/page.tsx",
    "src/components/dashboard/BirthdaysCard.tsx",
    "src/components/employees/SocialFeedsSection.tsx",
    "src/components/employees/IdentityVerification.tsx",
    "src/app/api/birthdays/route.ts",
    "src/app/api/birthdays/wish/route.ts",
    "src/app/api/social-feed/route.ts",
    "src/app/api/social-feed/settings/route.ts",
    "src/app/api/users/profile/route.ts",
    "src/app/api/employees/route.ts",
    "src/app/api/employees/[id]/route.ts",
    "src/app/api/employees/[id]/verify-identity/route.ts",
    "src/app/api/employees/[id]/documents/route.ts",
    "src/app/api/cron/birthday-greetings/route.ts",
    "src/lib/aadhaar-qr.ts",
    "src/lib/digilocker.ts",
    "src/lib/feed-permissions.ts",
    "src/lib/employee-row-collections.ts",
    "src/lib/navData.tsx"
  ],
  "exclude": ["node_modules"]
}
